# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real credentials.

# SMTP credentials for sending RFQ notification emails (see RFQ_EMAIL_SETUP.md)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@rreinternational.com
SMTP_PASS=

# Optional — defaults to info@rreinternational.com if not set
RFQ_NOTIFICATION_EMAIL=info@rreinternational.com
