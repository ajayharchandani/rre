<!-- src/views/pages/product-detail.ejs -->
<%- include('../partials/breadcrumbs') %>

<section style="padding: 3.5rem 0; background: #ffffff;">
  <div class="container">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 3rem; align-items: start;">
      
      <!-- Product Header & Visual Media -->
      <div>
        <div style="display: flex; gap: 0.5rem; margin-bottom: 1rem; flex-wrap: wrap;">
          <span class="badge badge-brand"><%= product.brandName %></span>
          <span class="badge badge-instock"><%= product.availabilityText || 'In Stock' %></span>
          <span class="badge" style="background: #f1f5f9; color: #475569;">HSN: <%= product.hsnCode %></span>
        </div>

        <h1 style="font-size: 2.1rem; margin-bottom: 0.75rem; line-height: 1.25; color: #0f172a;">
          <%= product.name %>
        </h1>

        <!-- Product Image / Technical Schematic -->
        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 1.5rem; text-align: center; margin-bottom: 1.5rem; box-shadow: var(--shadow-sm);">
          <img src="<%= product.image || '/images/products/hydraulic-pump-335y1459.svg' %>" alt="<%= product.name %>" style="max-height: 240px; margin: 0 auto; object-fit: contain;">
          <div style="font-size: 0.8rem; color: #64748b; margin-top: 0.75rem; font-weight: 600;">
            100% CMM Inspected · VCI Anti-Rust Oceanic Packaging
          </div>
        </div>

        <!-- Part Number Display Box -->
        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1.25rem; margin-bottom: 1.5rem;">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
            <span style="font-size: 0.85rem; color: #64748b; font-weight: 600; text-transform: uppercase;">Primary OE Reference:</span>
            <a href="/parts/<%= product.normalizedPartNumber %>" style="color: #0284c7; font-size: 0.82rem; font-weight: 700; text-decoration: underline;">
              Dedicated Part Page →
            </a>
          </div>
          <div style="font-family: monospace; font-size: 1.75rem; font-weight: 800; color: #0f172a; letter-spacing: 0.05em;">
            <%= product.partNumber %>
          </div>
          <% if (product.sku) { %>
            <div style="font-size: 0.85rem; color: #64748b; margin-top: 0.25rem;">
              RRE Internal SKU: <strong><%= product.sku %></strong>
            </div>
          <% } %>
        </div>

        <!-- Alternative & Cross-reference Numbers -->
        <% if (product.alternativePartNumbers && product.alternativePartNumbers.length > 0) { %>
          <div style="margin-bottom: 1.5rem;">
            <div style="font-size: 0.85rem; font-weight: 700; color: #64748b; margin-bottom: 0.5rem; text-transform: uppercase;">
              Alternative & Cross-Reference Numbers:
            </div>
            <div style="display: flex; flex-wrap: wrap; gap: 0.5rem;">
              <% product.alternativePartNumbers.forEach(alt => { %>
                <span style="background: #ffffff; border: 1px solid #cbd5e1; font-family: monospace; font-size: 0.85rem; padding: 0.25rem 0.6rem; border-radius: 4px; color: #334155;">
                  <strong><%= alt.partNumber %></strong> <span style="font-size: 0.75rem; color: #64748b;">(<%= alt.type %>)</span>
                </span>
              <% }) %>
            </div>
          </div>
        <% } %>

        <!-- Conversion CTAs -->
        <div style="display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 2rem;">
          <a href="/rfq?part=<%= encodeURIComponent(product.partNumber) %>&product=<%= encodeURIComponent(product.name) %>&machine=<%= encodeURIComponent(product.machineName) %>" class="btn btn-primary" style="padding: 0.85rem 1.75rem; font-size: 1rem; flex: 1;">
            📋 Request Export Quote (RFQ)
          </a>
          <a href="<%= whatsAppUrl %>" class="btn btn-whatsapp" style="padding: 0.85rem 1.75rem; font-size: 1rem; flex: 1;" target="_blank" rel="noopener">
            💬 WhatsApp (<%= organization.contact.phoneDisplay %>)
          </a>
        </div>

        <!-- Trust Signals Checklist -->
        <div style="background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: 8px; padding: 1.25rem; font-size: 0.88rem; color: #065f46;">
          <div style="font-weight: 800; margin-bottom: 0.4rem;">✓ RRE International Quality & Export Guarantee:</div>
          <ul style="list-style: none; padding-left: 0; line-height: 1.65;">
            <li>• 100% CMM dimensional verification against OEM drawings</li>
            <li>• ISO 9001:2015 certified factory (Cert No: <%= organization.certification.certificateNumber %>)</li>
            <li>• VCI anti-corrosion barrier packaging for 30+ days sea freight</li>
            <li>• Direct FOB / CIF export documentation with Certificate of Origin</li>
          </ul>
        </div>

      </div>

      <!-- Description & Technical Specifications -->
      <div>
        <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 2rem; box-shadow: var(--shadow-sm);">
          
          <h2 style="font-size: 1.4rem; margin-bottom: 1rem; border-bottom: 2px solid #f59e0b; padding-bottom: 0.5rem; color: #0f172a;">
            Product Overview & Engineering Details
          </h2>
          <p style="color: #334155; line-height: 1.7; margin-bottom: 1.5rem;">
            <%= product.description %>
          </p>

          <!-- Specifications Table -->
          <h3 style="font-size: 1.15rem; margin-bottom: 0.75rem; color: #0f172a;">Technical Specifications</h3>
          <table class="spec-table">
            <tbody>
              <% Object.entries(product.specifications || {}).forEach(([key, val]) => { %>
                <tr>
                  <th style="width: 40%; font-weight: 600;"><%= key %></th>
                  <td style="color: #0f172a;"><%= val %></td>
                </tr>
              <% }) %>
              <tr>
                <th>Minimum Order Qty (MOQ)</th>
                <td><%= product.moq %> piece(s) (Container consolidation available)</td>
              </tr>
            </tbody>
          </table>

          <!-- Compatible Machine Models Table -->
          <h3 style="font-size: 1.15rem; margin-top: 1.75rem; margin-bottom: 0.75rem; color: #0f172a;">Machine Model Compatibility</h3>
          <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.5rem;">
            <% internalLinks.compatibleModels.forEach(cm => { %>
              <a href="<%= cm.url %>" style="background: #f8fafc; border: 1px solid #cbd5e1; padding: 0.4rem 0.75rem; border-radius: 4px; font-size: 0.85rem; font-weight: 600; color: #0f172a;">
                🚜 <%= cm.name %>
              </a>
            <% }) %>
          </div>

        </div>
      </div>

    </div>

    <!-- Product FAQ Section -->
    <% if (product.faqs && product.faqs.length > 0) { %>
      <div style="margin-top: 4.5rem; max-width: 860px;">
        <h2 style="font-size: 1.75rem; margin-bottom: 1.5rem; color: #0f172a;">Frequently Asked Technical & Procurement Questions</h2>
        <div style="display: flex; flex-direction: column; gap: 1.25rem;">
          <% product.faqs.forEach(faq => { %>
            <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1.5rem;">
              <h3 style="font-size: 1.1rem; margin-bottom: 0.5rem; color: #0f172a;"><%= faq.question %></h3>
              <p style="color: #475569; font-size: 0.95rem; line-height: 1.6;"><%= faq.answer %></p>
            </div>
          <% }) %>
        </div>
      </div>
    <% } %>

    <!-- Related Products -->
    <% if (internalLinks.relatedProducts && internalLinks.relatedProducts.length > 0) { %>
      <div style="margin-top: 4.5rem; border-top: 1px solid #e2e8f0; padding-top: 3.5rem;">
        <h2 style="font-size: 1.75rem; margin-bottom: 2rem; color: #0f172a;">Related <%= product.categoryName %> Components</h2>
        <div class="grid-cards">
          <% internalLinks.relatedProducts.forEach(rel => { %>
            <article class="card">
              <span style="font-family: monospace; font-weight: 700; color: #64748b; font-size: 0.85rem; margin-bottom: 0.5rem;">
                PN: <%= rel.partNumber %>
              </span>
              <h3 style="font-size: 1.05rem; margin-bottom: 0.75rem;">
                <a href="<%= rel.url %>"><%= rel.name %></a>
              </h3>
              <a href="<%= rel.url %>" class="btn btn-outline" style="margin-top: auto; font-size: 0.85rem;">
                View Part Specs →
              </a>
            </article>
          <% }) %>
        </div>
      </div>
    <% } %>

  </div>
</section>
