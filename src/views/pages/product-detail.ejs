<!-- src/views/pages/product-detail.ejs -->
<%- include('../partials/breadcrumbs') %>

<section style="padding: 3.5rem 0; background: #ffffff;">
  <div class="container">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 3rem; align-items: start;">

      <!-- Product Image -->
      <div>
        <div style="display: flex; gap: 0.5rem; margin-bottom: 1rem; flex-wrap: wrap;">
          <% if (category) { %>
            <span class="badge badge-brand"><%= category.name %></span>
          <% } %>
          <span class="badge" style="background: #f1f5f9; color: #475569;">HSN: <%= product.hsn %></span>
          <span class="badge" style="background: #f1f5f9; color: #475569;">GST: <%= product.gst %>%</span>
        </div>

        <h1 style="font-size: 2.1rem; margin-bottom: 0.75rem; line-height: 1.25; color: #0f172a;">
          <%= product.description %>
        </h1>

        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 1.5rem; text-align: center; margin-bottom: 1.5rem; box-shadow: var(--shadow-sm);">
          <img src="<%= product.image_url || '/images/products/rre-image-coming-soon.svg' %>" alt="<%= product.description %>" style="max-height: 240px; margin: 0 auto; object-fit: contain;">
          <% if (product.image_status === 'source_image') { %>
            <div style="font-size: 0.78rem; color: #64748b; margin-top: 0.75rem;">Photo from RRE International's product catalogue</div>
          <% } else { %>
            <div style="font-size: 0.78rem; color: #94a3b8; margin-top: 0.75rem;">Photograph not yet available for this part</div>
          <% } %>
        </div>

        <!-- Part Number Display Box -->
        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 1.25rem; margin-bottom: 1.5rem;">
          <div style="font-size: 0.85rem; color: #64748b; font-weight: 600; text-transform: uppercase; margin-bottom: 0.5rem;">Part Number</div>
          <div style="font-family: monospace; font-size: 1.75rem; font-weight: 800; color: #0f172a; letter-spacing: 0.05em;">
            <%= product.part_number %>
          </div>
        </div>

        <!-- Conversion CTAs -->
        <div style="display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 2rem;">
          <a href="/rfq?part=<%= encodeURIComponent(product.part_number) %>&product=<%= encodeURIComponent(product.description) %>" class="btn btn-primary" style="padding: 0.85rem 1.75rem; font-size: 1rem; flex: 1;">
            📋 Request Export Quote (RFQ)
          </a>
          <a href="<%= whatsAppUrl %>" class="btn btn-whatsapp" style="padding: 0.85rem 1.75rem; font-size: 1rem; flex: 1;" target="_blank" rel="noopener">
            💬 WhatsApp (<%= organization.contact.phoneDisplay %>)
          </a>
        </div>
      </div>

      <!-- Details -->
      <div>
        <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 10px; padding: 2rem; box-shadow: var(--shadow-sm);">

          <h2 style="font-size: 1.4rem; margin-bottom: 1rem; border-bottom: 2px solid #f59e0b; padding-bottom: 0.5rem; color: #0f172a;">
            Product Details
          </h2>

          <table class="spec-table">
            <tbody>
              <tr>
                <th style="width: 40%; font-weight: 600;">Part Number</th>
                <td style="color: #0f172a; font-family: monospace;"><%= product.part_number %></td>
              </tr>
              <tr>
                <th style="font-weight: 600;">Description</th>
                <td style="color: #0f172a;"><%= product.description %></td>
              </tr>
              <tr>
                <th style="font-weight: 600;">Category</th>
                <td style="color: #0f172a;"><% if (category) { %><a href="/parts/<%= category.slug %>"><%= category.name %></a><% } else { %><%= product.category_name %><% } %></td>
              </tr>
              <tr>
                <th style="font-weight: 600;">HSN Code</th>
                <td style="color: #0f172a;"><%= product.hsn %></td>
              </tr>
              <tr>
                <th style="font-weight: 600;">GST Rate</th>
                <td style="color: #0f172a;"><%= product.gst %>%</td>
              </tr>
              <% if (product.show_price && product.mrp) { %>
                <tr>
                  <th style="font-weight: 600;">MRP</th>
                  <td style="color: #0f172a;">₹<%= product.mrp.toLocaleString('en-IN') %></td>
                </tr>
              <% } %>
            </tbody>
          </table>

          <div style="margin-top: 1.5rem; padding: 1.25rem; background: #f8fafc; border-radius: 8px; font-size: 0.9rem; color: #334155;">
            Pricing shown in our master price list is for domestic reference only. For export FOB / CIF pricing based on destination and order quantity, please request a quote via WhatsApp or the RFQ form.
          </div>

        </div>
      </div>

    </div>

    <!-- Related Products -->
    <% if (internalLinks.relatedProducts && internalLinks.relatedProducts.length > 0) { %>
      <div style="margin-top: 4.5rem; border-top: 1px solid #e2e8f0; padding-top: 3.5rem;">
        <h2 style="font-size: 1.75rem; margin-bottom: 2rem; color: #0f172a;">Related <%= category ? category.name : 'Parts' %></h2>
        <div class="grid-cards">
          <% internalLinks.relatedProducts.forEach(rel => { %>
            <article class="card">
              <span style="font-family: monospace; font-weight: 700; color: #64748b; font-size: 0.85rem; margin-bottom: 0.5rem;">
                PN: <%= rel.partNumber %>
              </span>
              <h3 style="font-size: 1.05rem; margin-bottom: 0.75rem;">
                <a href="<%= rel.url %>"><%= rel.name %></a>
              </h3>
              <a href="<%= rel.url %>" class="btn btn-outline" style="margin-top: auto; font-size: 0.85rem;">
                View Part Details →
              </a>
            </article>
          <% }) %>
        </div>
      </div>
    <% } %>

  </div>
</section>
