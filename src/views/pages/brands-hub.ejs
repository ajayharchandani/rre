<!-- src/views/pages/brands-hub.ejs -->
<%- include('../partials/breadcrumbs') %>

<section style="padding: 3rem 0; background: #f8fafc; border-bottom: 1px solid #e2e8f0;">
  <div class="container">
    <h1 style="font-size: 2.25rem; margin-bottom: 0.75rem;">Supported Heavy Machinery Brands</h1>
    <p style="color: #64748b; font-size: 1.05rem; max-width: 820px;">
      RRE International manufactures precision aftermarket replacement parts engineered to original equipment fitment standards for leading construction earthmoving brands.
    </p>
  </div>
</section>

<section style="padding: 4rem 0;">
  <div class="container">
    <div class="grid-cards">
      <% brands.forEach(b => { %>
        <article class="card">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <span class="badge badge-brand"><%= b.countryOfOrigin %></span>
            <span style="font-size: 1.25rem;">🚜</span>
          </div>
          <h2 style="font-size: 1.5rem; margin-bottom: 0.5rem;">
            <a href="/brands/<%= b.slug %>"><%= b.name %></a>
          </h2>
          <p class="card-desc"><%= b.overview %></p>
          
          <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 4px; padding: 0.75rem; margin-bottom: 1.25rem; font-size: 0.8rem; color: #475569;">
            <strong>Verified Scope:</strong> <%= b.verificationStatus %>
          </div>

          <a href="/brands/<%= b.slug %>" class="btn btn-primary" style="margin-top: auto;">
            Explore <%= b.name %> Parts Catalog →
          </a>
        </article>
      <% }) %>
    </div>
  </div>
</section>
