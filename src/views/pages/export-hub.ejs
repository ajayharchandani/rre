<!-- src/views/pages/export-hub.ejs -->
<%- include('../partials/breadcrumbs') %>

<section style="padding: 3rem 0; background: #f8fafc; border-bottom: 1px solid #e2e8f0;">
  <div class="container">
    <h1 style="font-size: 2.25rem; margin-bottom: 0.75rem;">International Export Destinations & Sea Freight Logistics</h1>
    <p style="color: #64748b; font-size: 1.05rem; max-width: 820px;">
      RRE International exports heavy earthmoving machinery spare parts directly from Indian maritime ports (Nhava Sheva & Mundra) to over 40 countries across the Middle East (GCC), Africa, and Southeast Asia.
    </p>
  </div>
</section>

<section style="padding: 4rem 0;">
  <div class="container">
    <div class="grid-cards">
      <% countries.forEach(cnt => { %>
        <article class="card">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
            <span class="badge badge-brand"><%= cnt.region %></span>
            <span style="font-size: 0.8rem; font-weight: 700; color: #10b981;"><%= cnt.transitTime.split('(')[0].trim() %></span>
          </div>
          <h2 style="font-size: 1.4rem; margin-bottom: 0.5rem;">
            <a href="/export/<%= cnt.slug %>"><%= cnt.name %></a>
          </h2>
          <p class="card-desc"><%= cnt.marketContext.substring(0, 140) %>...</p>

          <div style="font-size: 0.85rem; color: #475569; margin-bottom: 1.25rem;">
            <div><strong>Main Ports:</strong> <%= (cnt.majorPorts || []).join(', ') %></div>
          </div>

          <a href="/export/<%= cnt.slug %>" class="btn btn-primary" style="margin-top: auto; font-size: 0.85rem;">
            View <%= cnt.name %> Export & Spares Info →
          </a>
        </article>
      <% }) %>
    </div>
  </div>
</section>
