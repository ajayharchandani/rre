<!-- src/views/pages/resources-hub.ejs -->
<%- include('../partials/breadcrumbs') %>

<section style="padding: 3rem 0; background: #f8fafc; border-bottom: 1px solid #e2e8f0;">
  <div class="container">
    <h1 style="font-size: 2.25rem; margin-bottom: 0.75rem;">Technical & Spare Parts Procurement Guides</h1>
    <p style="color: #64748b; font-size: 1.05rem; max-width: 820px;">
      In-depth engineering documentation, cylinder seal kit identification charts, and international export guides written by RRE International's technical team.
    </p>
  </div>
</section>

<section style="padding: 4rem 0;">
  <div class="container" style="max-width: 960px;">
    <div style="display: flex; flex-direction: column; gap: 2rem;">
      <% resources.forEach(art => { %>
        <article style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 2rem; transition: transform 0.2s, box-shadow 0.2s;">
          <div style="display: flex; gap: 0.75rem; align-items: center; margin-bottom: 0.75rem;">
            <span class="badge badge-brand"><%= art.category %></span>
            <span style="font-size: 0.8rem; color: #64748b;"><%= art.readingTime %></span>
            <span style="font-size: 0.8rem; color: #64748b;">· Published: <%= art.publishedDate %></span>
          </div>

          <h2 style="font-size: 1.5rem; margin-bottom: 0.75rem;">
            <a href="/resources/<%= art.slug %>" style="color: #0f172a;"><%= art.title %></a>
          </h2>

          <p style="color: #475569; font-size: 0.95rem; line-height: 1.6; margin-bottom: 1.25rem;">
            <%= art.excerpt %>
          </p>

          <a href="/resources/<%= art.slug %>" style="color: #d97706; font-weight: 700; font-size: 0.95rem; display: inline-flex; align-items: center; gap: 0.35rem;">
            Read Complete Guide →
          </a>
        </article>
      <% }) %>
    </div>
  </div>
</section>
