<!-- src/views/pages/spare-parts-exporter.ejs -->
<%- include('../partials/breadcrumbs') %>

<section style="padding: 3.5rem 0; background: #0f172a; color: #ffffff;">
  <div class="container">
    <div style="max-width: 860px;">
      <span class="badge badge-brand" style="margin-bottom: 1rem;">Manufacturer &amp; Exporter · Delhi, India</span>
      <h1 style="font-size: clamp(2rem, 3.5vw, 2.6rem); color: #ffffff; margin-bottom: 1rem; line-height: 1.2;">
        Construction &amp; Heavy Equipment Spare Parts Exporter
      </h1>
      <p style="color: #cbd5e1; font-size: 1.1rem; line-height: 1.65; margin-bottom: 1.75rem;">
        <%= organization.name %> manufactures and exports aftermarket replacement spare parts for JCB, Caterpillar,
        Case and Komatsu earthmoving equipment. ISO 9001:2015 certified, in-house machining and metallurgy,
        VCI marine packaging, and FOB / CIF shipping from Indian ports to the Gulf, Africa and worldwide.
      </p>
      <div style="display: flex; gap: 0.85rem; flex-wrap: wrap;">
        <a href="/rfq" class="btn btn-primary">Request a Quotation (RFQ / BOM)</a>
        <a href="https://wa.me/<%= organization.contact.whatsappNumber %>?text=<%= encodeURIComponent('Hello RRE International, I would like a quotation for earthmoving spare parts for export.') %>" class="btn btn-whatsapp" target="_blank" rel="noopener">
          WhatsApp Export Desk (<%= organization.contact.phoneDisplay %>)
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Trademark note -->
<section style="padding: 0.9rem 0; background: #fef3c7; border-bottom: 1px solid #fde68a; font-size: 0.85rem; color: #92400e;">
  <div class="container">
    <strong>Independent supplier:</strong> RRE International is not an authorised dealer or franchise of any equipment
    manufacturer. OEM names and part numbers are used for identification and cross-reference only.
  </div>
</section>

<!-- What we supply -->
<section style="padding: 4rem 0; background: #ffffff;">
  <div class="container">
    <h2 style="font-size: 1.75rem; margin-bottom: 0.5rem; color: #0f172a;">Equipment Brands We Supply</h2>
    <p style="color: #64748b; font-size: 0.95rem; margin-bottom: 2rem; max-width: 760px;">
      The JCB range is digitised online — <%= totalListings.toLocaleString('en-IN') %> part references across
      <%= allCategories.length %> component categories. Caterpillar, Case and Komatsu parts are supplied to order.
    </p>
    <div class="grid-cards" style="margin-bottom: 3.5rem;">
      <% brands.forEach(b => { %>
        <div class="card">
          <span class="badge badge-brand" style="margin-bottom: 0.5rem;"><%= b.countryOfOrigin %></span>
          <h3 style="font-size: 1.2rem; margin-bottom: 0.4rem;">
            <a href="/brands/<%= b.slug %>" style="color: #0f172a;"><%= b.name %> Spare Parts</a>
          </h3>
          <p class="card-desc"><%= b.overview %></p>
          <a href="/brands/<%= b.slug %>" class="btn btn-outline" style="margin-top: auto; font-size: 0.85rem;">
            View <%= b.name %> parts →
          </a>
        </div>
      <% }) %>
    </div>

    <h2 style="font-size: 1.75rem; margin-bottom: 0.5rem; color: #0f172a;">Parts by Component System</h2>
    <p style="color: #64748b; font-size: 0.95rem; margin-bottom: 1.75rem; max-width: 760px;">
      Hydraulic seal kits, pins and bushes, transmission and drivetrain, engine and cooling, electrical and
      solenoid, undercarriage wear parts, filters and more.
    </p>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0.85rem; margin-bottom: 1.5rem;">
      <% topCategories.forEach(cat => { %>
        <a href="/parts/<%= cat.slug %>" style="display: block; padding: 1rem 1.15rem; border: 1px solid #e2e8f0; border-radius: 8px; text-decoration: none; background: #fff;">
          <span style="display: block; font-weight: 700; color: #0f172a; font-size: 0.98rem;"><%= cat.name %></span>
          <span style="display: block; font-size: 0.82rem; color: #64748b; margin-top: 0.15rem;"><%= cat.count.toLocaleString('en-IN') %> listings</span>
        </a>
      <% }) %>
    </div>
    <a href="/products" style="color: #d97706; font-weight: 700; font-size: 0.95rem;">Browse the full parts catalogue →</a>
  </div>
</section>

<!-- Manufacturing & quality -->
<section style="padding: 4rem 0; background: #f8fafc;">
  <div class="container">
    <h2 style="font-size: 1.75rem; margin-bottom: 0.5rem; color: #0f172a;">In-House Manufacturing &amp; Quality</h2>
    <p style="color: #475569; font-size: 1rem; line-height: 1.7; max-width: 820px; margin-bottom: 1.5rem;">
      <%= organization.name %> operates under <strong><%= organization.certification.title %></strong>
      (Certificate No. <%= organization.certification.certificateNumber %>, <%= organization.certification.issuingBody %>).
      Parts are made and inspected at the company's plant in <%= organization.facility.location %>:
    </p>
    <ul style="color: #334155; font-size: 0.95rem; line-height: 1.9; columns: 2; column-gap: 3rem; max-width: 820px; margin-bottom: 1.5rem;">
      <% organization.facility.capabilities.forEach(c => { %><li><%= c %></li><% }) %>
    </ul>
    <a href="/about" style="color: #d97706; font-weight: 700; font-size: 0.95rem;">See the facility &amp; quality page →</a>
  </div>
</section>

<!-- Export process -->
<section style="padding: 4rem 0; background: #ffffff;">
  <div class="container">
    <h2 style="font-size: 1.75rem; margin-bottom: 0.5rem; color: #0f172a;">Export &amp; Shipping</h2>
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem; margin: 1.5rem 0 2rem;">
      <div style="border: 1px solid #e2e8f0; border-radius: 8px; padding: 1.5rem;">
        <h3 style="font-size: 1.05rem; margin-bottom: 0.5rem; color: #0f172a;">Incoterms</h3>
        <p style="font-size: 0.92rem; color: #475569; line-height: 1.6; margin: 0;">FOB Nhava Sheva (JNPT) or Mundra, or CIF to your destination port.</p>
      </div>
      <div style="border: 1px solid #e2e8f0; border-radius: 8px; padding: 1.5rem;">
        <h3 style="font-size: 1.05rem; margin-bottom: 0.5rem; color: #0f172a;">Consolidation</h3>
        <p style="font-size: 0.92rem; color: #475569; line-height: 1.6; margin: 0;">LCL and FCL; dense steel parts balanced with light-volume items to keep freight cost per part down.</p>
      </div>
      <div style="border: 1px solid #e2e8f0; border-radius: 8px; padding: 1.5rem;">
        <h3 style="font-size: 1.05rem; margin-bottom: 0.5rem; color: #0f172a;">Marine packaging</h3>
        <p style="font-size: 0.92rem; color: #475569; line-height: 1.6; margin: 0;">VCI rust-inhibitor oil, vacuum barrier film, foam/crating and desiccant in ISPM-15 cases for long voyages.</p>
      </div>
      <div style="border: 1px solid #e2e8f0; border-radius: 8px; padding: 1.5rem;">
        <h3 style="font-size: 1.05rem; margin-bottom: 0.5rem; color: #0f172a;">Documentation</h3>
        <p style="font-size: 0.92rem; color: #475569; line-height: 1.6; margin: 0;">Certificate of Origin, chamber-attested invoices, and regional conformity (SABER, SONCAP, PVoC, QGOS) prepared or coordinated.</p>
      </div>
    </div>
    <a href="/export-process" style="color: #d97706; font-weight: 700; font-size: 0.95rem;">Full export process &amp; Incoterms →</a>
  </div>
</section>

<!-- Markets -->
<section style="padding: 4rem 0; background: #f8fafc;">
  <div class="container">
    <h2 style="font-size: 1.75rem; margin-bottom: 0.5rem; color: #0f172a;">Export Destinations</h2>
    <p style="color: #64748b; font-size: 0.95rem; margin-bottom: 1.75rem; max-width: 760px;">
      Country pages carry port, transit-time and customs detail for each market.
    </p>
    <div style="display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 1rem;">
      <% countries.forEach(c => { %>
        <a href="/export/<%= c.slug %>" class="btn btn-outline" style="font-size: 0.85rem;">Spare parts to <%= c.name %> →</a>
      <% }) %>
    </div>
    <a href="/export" style="color: #d97706; font-weight: 700; font-size: 0.95rem;">All export markets →</a>
  </div>
</section>

<!-- Guides -->
<section style="padding: 4rem 0; background: #ffffff;">
  <div class="container">
    <h2 style="font-size: 1.75rem; margin-bottom: 1.5rem; color: #0f172a;">Procurement &amp; Technical Guides</h2>
    <div style="display: flex; flex-direction: column; gap: 1.25rem; max-width: 820px;">
      <% resources.forEach(r => { %>
        <div>
          <h3 style="font-size: 1.1rem; margin-bottom: 0.25rem;">
            <a href="/resources/<%= r.slug %>" style="color: #0f172a;"><%= r.title %></a>
          </h3>
          <p style="font-size: 0.88rem; color: #64748b; margin: 0;"><%= r.excerpt.substring(0, 150) %>…</p>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- FAQ -->
<% if (typeof faqs !== 'undefined' && faqs.length) { %>
<section style="padding: 4rem 0; background: #f8fafc;">
  <div class="container" style="max-width: 860px;">
    <h2 style="font-size: 1.6rem; margin-bottom: 1.5rem; color: #0f172a;">Frequently Asked Questions</h2>
    <% faqs.forEach(f => { %>
      <div style="margin-bottom: 1.5rem;">
        <h3 style="font-size: 1.05rem; margin-bottom: 0.4rem; color: #0f172a;"><%= f.question %></h3>
        <p style="color: #475569; font-size: 0.95rem; line-height: 1.6; margin: 0;"><%= f.answer %></p>
      </div>
    <% }) %>
  </div>
</section>
<% } %>

<!-- CTA -->
<section style="padding: 3.5rem 0; background: linear-gradient(135deg, #0f172a, #1e293b); color: #ffffff;">
  <div class="container" style="text-align: center;">
    <h2 style="color: #ffffff; font-size: 1.5rem; margin-bottom: 0.5rem;">Send Your Part List for a Quotation</h2>
    <p style="color: #cbd5e1; font-size: 0.95rem; margin-bottom: 1.5rem;">
      Part numbers in any format, quantities, machine models and destination port — by RFQ form or WhatsApp.
    </p>
    <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
      <a href="/rfq" class="btn btn-primary">Submit RFQ / Bill of Materials</a>
      <a href="https://wa.me/<%= organization.contact.whatsappNumber %>?text=<%= encodeURIComponent('Hello RRE International, I would like a quotation for earthmoving spare parts for export.') %>" class="btn btn-whatsapp" target="_blank" rel="noopener">WhatsApp Export Desk</a>
    </div>
  </div>
</section>
