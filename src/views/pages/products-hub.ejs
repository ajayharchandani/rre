<!-- src/views/pages/products-hub.ejs -->
<%- include('../partials/breadcrumbs') %>

<section style="padding: 3rem 0; background: #f8fafc; border-bottom: 1px solid #e2e8f0;">
  <div class="container">
    <h1 style="font-size: 2.25rem; margin-bottom: 0.75rem;">Heavy Earthmoving Machinery Spare Parts Taxonomy</h1>
    <p style="color: #64748b; font-size: 1.05rem; max-width: 820px;">
      Explore our 12 component categories covering hydraulic seal kits, induction-hardened pins, bronze bushes, transmission crown wheel pinions, tandem pumps, and excavator wear components.
    </p>
  </div>
</section>

<section style="padding: 4rem 0;">
  <div class="container">
    <div class="grid-cards">
      <% categories.forEach(cat => { %>
        <article class="card">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <span class="badge badge-brand"><%= cat.shortName %></span>
            <span style="font-size: 1.25rem;">⚙️</span>
          </div>
          <h2 style="font-size: 1.3rem; margin-bottom: 0.5rem;">
            <a href="/products/<%= cat.slug %>"><%= cat.name %></a>
          </h2>
          <p class="card-desc"><%= cat.description %></p>

          <div style="margin-bottom: 1.25rem;">
            <div style="font-size: 0.8rem; font-weight: 700; color: #64748b; margin-bottom: 0.5rem;">Sub-Categories:</div>
            <ul style="list-style: none; font-size: 0.85rem; color: #334155;">
              <% (cat.subcategories || []).forEach(sub => { %>
                <li style="padding: 0.2rem 0; display: flex; align-items: center; gap: 0.35rem;">
                  <span style="color: #f59e0b;">▸</span> <%= sub %>
                </li>
              <% }) %>
            </ul>
          </div>

          <a href="/products/<%= cat.slug %>" class="btn btn-primary" style="margin-top: auto; font-size: 0.85rem;">
            View <%= cat.name %> Catalog →
          </a>
        </article>
      <% }) %>
    </div>
  </div>
</section>
