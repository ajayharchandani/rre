<!-- src/views/pages/products-hub.ejs -->
<%- include('../partials/breadcrumbs') %>

<section style="padding: 3rem 0; background: #f8fafc; border-bottom: 1px solid #e2e8f0;">
  <div class="container">
    <h1 style="font-size: 2.25rem; margin-bottom: 0.75rem;">Spare Parts Categories</h1>
    <p style="color: #64748b; font-size: 1.05rem; max-width: 820px;">
      <%= realCategories.length %> categories from RRE International's master price list, covering
      <%= realCategories.reduce((sum, c) => sum + c.count, 0).toLocaleString('en-IN') %> spare part listings.
    </p>
  </div>
</section>

<section style="padding: 4rem 0;">
  <div class="container">
    <div class="grid-cards">
      <% realCategories.forEach(cat => { %>
        <article class="card">
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <span class="badge badge-brand"><%= cat.code %></span>
            <span style="font-size: 1.25rem;">⚙️</span>
          </div>
          <h2 style="font-size: 1.3rem; margin-bottom: 0.5rem;">
            <a href="/parts/<%= cat.slug %>"><%= cat.name %></a>
          </h2>
          <p class="card-desc"><%= cat.count.toLocaleString('en-IN') %> part listings</p>

          <a href="/parts/<%= cat.slug %>" class="btn btn-primary" style="margin-top: auto; font-size: 0.85rem;">
            View <%= cat.name %> Catalog →
          </a>
        </article>
      <% }) %>
    </div>
  </div>
</section>
