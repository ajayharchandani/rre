<!-- src/views/pages/model-detail.ejs -->
<%- include('../partials/breadcrumbs') %>

<section style="padding: 3.5rem 0; background: #0f172a; color: #ffffff;">
  <div class="container">
    <div style="max-width: 820px;">
      <span class="badge badge-brand" style="margin-bottom: 1rem;"><%= model.yearRange %></span>
      <h1 style="font-size: 2.25rem; color: #ffffff; margin-bottom: 0.75rem;"><%= model.name %></h1>
      <div style="font-size: 1.1rem; color: #fbbf24; margin-bottom: 1.25rem;">
        Engine: <%= model.engineVariant %> · Hydraulics: <%= model.hydraulicVariant %>
      </div>
      <p style="color: #cbd5e1; font-size: 1.05rem; line-height: 1.6; margin-bottom: 2rem;">
        <%= model.description %>
      </p>

      <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
        <a href="/rfq?machine=<%= encodeURIComponent(model.name) %>" class="btn btn-primary">
          Submit RFQ for <%= model.name %>
        </a>
        <a href="https://wa.me/<%= organization.contact.whatsappNumber %>?text=<%= encodeURIComponent('Hello RRE International, I need spare parts for ' + model.name + '.') %>" class="btn btn-whatsapp" target="_blank" rel="noopener">
          WhatsApp Fast Quote
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Sourcing parts for this variant -->
<section style="padding: 4rem 0;">
  <div class="container">
    <h2 style="font-size: 1.75rem; margin-bottom: 0.5rem;">Sourcing Spare Parts for the <%= model.name %></h2>
    <p style="color: #475569; max-width: 720px; margin-bottom: 2rem; line-height: 1.6;">
      This variant runs the <strong><%= model.engineVariant %></strong> with a <strong><%= model.hydraulicVariant %></strong>.
      Hydraulic seal kits, pump flanges, cooling parts and transmission components can differ from other
      <%= machine ? machine.name : 'model' %> production years, so match parts to your machine's serial number.
      Browse RRE International's replacement parts by system:
    </p>

    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0.85rem; margin-bottom: 3rem;">
      <% allCategories.forEach(cat => { %>
        <a href="/parts/<%= cat.slug %>" style="display: block; padding: 0.9rem 1.1rem; border: 1px solid #e2e8f0; border-radius: 8px; text-decoration: none; background: #fff;">
          <span style="display: block; font-weight: 700; color: #0f172a; font-size: 0.95rem;"><%= cat.name %></span>
          <span style="display: block; font-size: 0.8rem; color: #64748b; margin-top: 0.15rem;"><%= cat.count.toLocaleString('en-IN') %> listings</span>
        </a>
      <% }) %>
    </div>

    <div style="display: flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 3.5rem;">
      <a href="/rfq?machine=<%= encodeURIComponent(model.name) %>" class="btn btn-primary">Request a Quote for the <%= model.name %></a>
      <a href="https://wa.me/<%= organization.contact.whatsappNumber %>?text=<%= encodeURIComponent('Hello RRE International, I need spare parts for ' + model.name + ' (serial number: ). ') %>" class="btn btn-whatsapp" target="_blank" rel="noopener">WhatsApp with your serial number</a>
    </div>

    <!-- Other variants of this platform -->
    <% if (typeof siblingModels !== 'undefined' && siblingModels.length) { %>
      <h2 style="font-size: 1.4rem; margin-bottom: 1.25rem; color: #0f172a;">Other <%= machine ? machine.name : model.brandSlug.toUpperCase() %> Production Variants</h2>
      <div class="grid-cards" style="margin-bottom: 3.5rem;">
        <% siblingModels.forEach(sm => { %>
          <div class="card" style="border-left: 4px solid #cbd5e1; border-radius: 8px;">
            <span style="font-size: 0.8rem; font-weight: 700; color: #64748b;"><%= sm.yearRange %></span>
            <h3 style="font-size: 1.1rem; margin: 0.25rem 0 0.5rem;">
              <a href="/machines/<%= sm.brandSlug %>/<%= sm.slug %>" style="color: #0f172a;"><%= sm.name %></a>
            </h3>
            <div style="font-size: 0.83rem; color: #64748b;"><%= sm.engineVariant %></div>
          </div>
        <% }) %>
      </div>
    <% } %>

    <!-- FAQ (mirrors FAQPage schema) -->
    <% if (typeof faqs !== 'undefined' && faqs.length) { %>
      <div style="border-top: 1px solid #e2e8f0; padding-top: 2.5rem; margin-bottom: 3rem;">
        <h2 style="font-size: 1.5rem; margin-bottom: 1.5rem; color: #0f172a;">Frequently Asked Questions</h2>
        <% faqs.forEach(f => { %>
          <div style="margin-bottom: 1.5rem;">
            <h3 style="font-size: 1.02rem; margin-bottom: 0.4rem; color: #0f172a;"><%= f.question %></h3>
            <p style="color: #475569; font-size: 0.94rem; line-height: 1.6; margin: 0;"><%= f.answer %></p>
          </div>
        <% }) %>
      </div>
    <% } %>

    <!-- Parent Machine Navigation -->
    <div style="padding-top: 2rem; border-top: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
      <a href="<%= internalLinks.parentMachineUrl %>" class="btn btn-outline">
        ← All <%= machine ? machine.name : model.brandSlug.toUpperCase() %> parts
      </a>
      <a href="<%= internalLinks.brandUrl %>" class="btn btn-outline">
        Explore all <%= model.brandSlug.toUpperCase() %> equipment →
      </a>
    </div>

  </div>
</section>
