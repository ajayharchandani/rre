<!-- src/views/pages/model-detail.ejs -->
<%- include('../partials/breadcrumbs') %>

<section style="padding: 3.5rem 0; background: #0f172a; color: #ffffff;">
  <div class="container">
    <div style="max-width: 820px;">
      <span class="badge badge-brand" style="margin-bottom: 1rem;"><%= model.yearRange %></span>
      <h1 style="font-size: 2.25rem; color: #ffffff; margin-bottom: 0.75rem;"><%= model.name %></h1>
      <div style="font-size: 1.1rem; color: #fbbf24; margin-bottom: 1.25rem;">
        Engine: <%= model.engineVariant %> · Hydraulics: <%= model.hydraulicVariant %>
      </div>
      <p style="color: #cbd5e1; font-size: 1.05rem; line-height: 1.6; margin-bottom: 2rem;">
        <%= model.description %>
      </p>

      <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
        <a href="/rfq?machine=<%= encodeURIComponent(model.name) %>" class="btn btn-primary">
          Submit RFQ for <%= model.name %>
        </a>
        <a href="https://wa.me/<%= organization.contact.whatsappNumber %>?text=<%= encodeURIComponent('Hello RRE International, I need spare parts for ' + model.name + '.') %>" class="btn btn-whatsapp" target="_blank" rel="noopener">
          WhatsApp Fast Quote
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Compatible Parts Section -->
<section style="padding: 4rem 0;">
  <div class="container">
    <h2 style="font-size: 1.75rem; margin-bottom: 2rem;">Verified Compatible Components for <%= model.name %></h2>

    <% if (internalLinks.compatibleProducts && internalLinks.compatibleProducts.length > 0) { %>
      <div class="grid-cards">
        <% internalLinks.compatibleProducts.forEach(prod => { %>
          <article class="card">
            <span style="font-family: monospace; font-weight: 700; color: #0f172a; font-size: 0.85rem; margin-bottom: 0.5rem;">
              PN: <%= prod.partNumber %>
            </span>
            <h3 style="font-size: 1.15rem; margin-bottom: 0.5rem;">
              <a href="<%= prod.url %>"><%= prod.name %></a>
            </h3>
            <div style="font-size: 0.85rem; color: #64748b; margin-bottom: 1rem;">
              Category: <strong><%= prod.categoryName %></strong>
            </div>
            <a href="<%= prod.url %>" class="btn btn-primary" style="margin-top: auto; font-size: 0.85rem;">
              View Technical Specs →
            </a>
          </article>
        <% }) %>
      </div>
    <% } %>

    <!-- Parent Machine Navigation -->
    <div style="margin-top: 4rem; padding-top: 2rem; border-top: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
      <a href="<%= internalLinks.parentMachineUrl %>" class="btn btn-outline">
        ← Back to <%= machine.name %> Overview
      </a>
      <a href="<%= internalLinks.brandUrl %>" class="btn btn-outline">
        Explore All <%= model.brandSlug.toUpperCase() %> Equipment →
      </a>
    </div>

  </div>
</section>
