<!-- src/views/pages/brand-detail.ejs -->
<%- include('../partials/breadcrumbs') %>

<section style="padding: 3.5rem 0; background: #0f172a; color: #ffffff;">
  <div class="container">
    <div style="max-width: 820px;">
      <span class="badge badge-brand" style="margin-bottom: 1rem;">Machinery Brand</span>
      <h1 style="font-size: 2.25rem; color: #ffffff; margin-bottom: 1rem;">Replacement Spare Parts for <%= brand.name %></h1>
      <p style="color: #cbd5e1; font-size: 1.1rem; line-height: 1.6; margin-bottom: 1.5rem;">
        <%= brand.overview %>
      </p>

      <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
        <a href="/rfq?brand=<%= encodeURIComponent(brand.name) %>" class="btn btn-primary">
          Request <%= brand.name %> Quote
        </a>
        <a href="https://wa.me/<%= organization.contact.whatsappNumber %>?text=<%= encodeURIComponent('Hello RRE International, I need price and availability for ' + brand.name + ' spare parts.') %>" class="btn btn-whatsapp" target="_blank" rel="noopener">
          WhatsApp <%= brand.name %> Desk
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Brand Disclaimer Notice -->
<section style="padding: 1rem 0; background: #fef3c7; border-bottom: 1px solid #fde68a; font-size: 0.85rem; color: #92400e;">
  <div class="container">
    <strong>Compatibility Note:</strong> <%= brand.disclaimer %>
  </div>
</section>

<!-- Machines for this Brand -->
<section style="padding: 4rem 0;">
  <div class="container">
    <h2 style="font-size: 1.75rem; margin-bottom: 2rem;"><%= brand.name %> Machine Models Supported</h2>

    <div class="grid-cards" style="margin-bottom: 4rem;">
      <% brandMachines.forEach(mach => { %>
        <div class="card">
          <span class="badge badge-brand" style="margin-bottom: 0.5rem;"><%= mach.type %></span>
          <h3 style="font-size: 1.25rem; margin-bottom: 0.5rem;">
            <a href="/machines/<%= mach.slug %>"><%= mach.name %></a>
          </h3>
          <p class="card-desc"><%= mach.description %></p>
          <a href="/machines/<%= mach.slug %>" class="btn btn-outline" style="margin-top: auto; font-size: 0.85rem;">
            View <%= mach.name %> Parts →
          </a>
        </div>
      <% }) %>
    </div>

    <!-- Category grid (digitised brands only) -->
    <% if (typeof brandCategories !== 'undefined' && brandCategories.length) { %>
      <h2 style="font-size: 1.75rem; margin-bottom: 0.5rem;"><%= brand.name %> Spare Parts by Category</h2>
      <p style="color: #64748b; font-size: 0.95rem; margin-bottom: 1.75rem; max-width: 760px;">
        <%= totalListings.toLocaleString('en-IN') %> <%= brand.name %> part numbers, organised by component system.
      </p>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0.85rem; margin-bottom: 4rem;">
        <% brandCategories.forEach(cat => { %>
          <a href="/parts/<%= cat.slug %>" style="display: block; padding: 1rem 1.15rem; border: 1px solid #e2e8f0; border-radius: 8px; text-decoration: none; background: #fff;">
            <span style="display: block; font-weight: 700; color: #0f172a; font-size: 0.98rem;"><%= cat.name %></span>
            <span style="display: block; font-size: 0.82rem; color: #64748b; margin-top: 0.15rem;"><%= cat.count.toLocaleString('en-IN') %> listings</span>
          </a>
        <% }) %>
      </div>
    <% } %>

    <!-- Featured Products for Brand -->
    <% if (brandProducts.length > 0) { %>
      <h2 style="font-size: 1.75rem; margin-bottom: 0.5rem;">Photographed <%= brand.name %> Spares from RRE's Catalogue</h2>
      <p style="color: #64748b; margin-bottom: 2rem; font-size: 0.9rem; max-width: 760px;">A sample of parts RRE stocks and photographs in-house.</p>
      <div class="grid-cards">
        <% brandProducts.forEach(prod => { %>
          <article class="product-card">
            <div class="product-card-img-wrap">
              <img src="<%= prod.image || '/images/products/rre-image-coming-soon.png' %>" alt="<%= prod.name %> — JCB Part No. <%= prod.partNumber %>" loading="lazy" onerror="this.onerror=null;this.src='/images/products/rre-image-coming-soon.png';">
            </div>
            <div class="product-card-body">
              <span style="font-family: monospace; font-weight: 700; color: #0f172a; font-size: 0.85rem; margin-bottom: 0.5rem;">
                PN: <%= prod.partNumber %>
              </span>
              <h3 style="font-size: 1.1rem; margin: 0.35rem 0;">
                <a href="/products/<%= prod.slug %>"><%= prod.name %></a>
              </h3>
              <a href="/products/<%= prod.slug %>" class="btn btn-primary" style="margin-top: auto; font-size: 0.85rem;">
                View Details →
              </a>
            </div>
          </article>
        <% }) %>
      </div>
    <% } else { %>
      <h2 style="font-size: 1.75rem; margin-bottom: 1rem;">Browse Our <%= brand.name %> Spare Parts</h2>
      <p style="color: #475569; max-width: 640px; margin-bottom: 1.5rem;">
        RRE International's illustrated online catalogue is currently JCB-only. For <%= brand.name %> part numbers, WhatsApp our export desk or submit an RFQ — our engineering team will confirm pricing and availability directly.
      </p>
    <% } %>

    <!-- FAQ (mirrors FAQPage schema) -->
    <% if (typeof faqs !== 'undefined' && faqs.length) { %>
      <div style="margin-top: 3.5rem; border-top: 1px solid #e2e8f0; padding-top: 2.5rem;">
        <h2 style="font-size: 1.6rem; margin-bottom: 1.5rem; color: #0f172a;">Frequently Asked Questions</h2>
        <% faqs.forEach(f => { %>
          <div style="margin-bottom: 1.5rem;">
            <h3 style="font-size: 1.05rem; margin-bottom: 0.4rem; color: #0f172a;"><%= f.question %></h3>
            <p style="color: #475569; font-size: 0.95rem; line-height: 1.6; margin: 0;"><%= f.answer %></p>
          </div>
        <% }) %>
      </div>
    <% } %>

  </div>
</section>
