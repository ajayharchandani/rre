    </svg>

    <!-- Floating Live Stats Overlay -->
    <div class="map-live-stats">
      <div class="map-stat-chip">
        <span class="map-stat-pulse"></span>
        <strong>45+</strong> Countries
      </div>
      <div class="map-stat-chip">
        <span class="map-stat-pulse gcc"></span>
        <strong>GCC</strong> 3–5 Days
      </div>
      <div class="map-stat-chip">
        <span class="map-stat-pulse africa"></span>
        <strong>Africa</strong> 18–28 Days
      </div>
      <div class="map-stat-chip">
        <span class="map-stat-pulse europe"></span>
        <strong>Europe</strong> 20–25 Days
      </div>
    </div>
  </div>

  <!-- Market Cards below map -->
  <div class="container" style="margin-top:2.5rem;">
    <div class="export-markets-grid">
      <% featuredCountries.forEach(cnt => { %>
        <div class="export-market-card" id="market-<%= cnt.slug %>">
          <div class="market-card-top">
            <h3 class="market-name"><%= cnt.name %></h3>
            <span class="market-region-tag"><%= cnt.region %></span>
          </div>
          <div class="market-transit">⏱ <strong><%= cnt.transitTime %></strong> Sea Transit</div>
          <div class="market-ports">
            <strong>Ports:</strong> <%= (cnt.majorPorts || []).slice(0,2).join(' · ') %>
          </div>
          <a href="/export/<%= cnt.slug %>" class="market-detail-link">Logistics Info & Requirements →</a>
        </div>
      <% }) %>
    </div>
  </div>
</section>



<!-- ===== MANUFACTURING EXCELLENCE SECTION ===== -->
<section class="manufacturing-section">
  <div class="container">
    <div class="manufacturing-grid">
      <div class="manufacturing-content">
        <div class="section-eyebrow">In-House Manufacturing — Delhi NCR</div>
        <h2 class="section-title">Precision Manufactured to Exact OEM Tolerances</h2>
        <p style="color: #64748b; line-height: 1.7; margin-bottom: 1.5rem;">
          Our Delhi facility houses CNC turning centers, 4-axis machining, induction surface hardening furnaces,
          precision cylindrical grinders, and a Coordinate Measuring Machine (CMM) — delivering parts that match
          or exceed original equipment quality.
        </p>

        <div class="manufacturing-capabilities-grid">
          <div class="capability-item">
            <span class="cap-icon">⚙️</span>
            <div>
              <div class="cap-title">CNC 4-Axis Machining</div>
              <div class="cap-desc">High-precision turning centers</div>
            </div>
          </div>
          <div class="capability-item">
            <span class="cap-icon">🔥</span>
            <div>
              <div class="cap-title">Induction Hardening</div>
              <div class="cap-desc">58–62 HRC case depth control</div>
            </div>
          </div>
          <div class="capability-item">
            <span class="cap-icon">📏</span>
            <div>
              <div class="cap-title">CMM Dimensional Check</div>
              <div class="cap-desc">Ra 0.4µm surface finish verified</div>
            </div>
          </div>
          <div class="capability-item">
            <span class="cap-icon">🧪</span>
            <div>
              <div class="cap-title">400-Bar Hydrostatic Test</div>
              <div class="cap-desc">High-pressure cylinder testing rig</div>
            </div>
          </div>
          <div class="capability-item">
            <span class="cap-icon">📦</span>
            <div>
              <div class="cap-title">VCI Anti-Corrosion Pack</div>
              <div class="cap-desc">Oceanic barrier packaging</div>
            </div>
          </div>
          <div class="capability-item">
            <span class="cap-icon">🏆</span>
            <div>
              <div class="cap-title">ISO 9001:2015 QMS</div>
              <div class="cap-desc">Euroswiss Certification Inc.</div>
            </div>
          </div>
        </div>

        <a href="/about" class="btn btn-primary" style="margin-top: 1.5rem;" id="about-facility-link">
          View Manufacturing Facility →
        </a>
