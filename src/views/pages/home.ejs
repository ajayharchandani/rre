      <div class="manufacturing-stats-panel">
        <div class="stat-card-large">
          <div class="stat-big-num">1984</div>
          <div class="stat-big-label">Year Established</div>
        </div>
        <div class="stat-card-large highlight">
          <div class="stat-big-num">85,000+</div>
          <div class="stat-big-label">Reference SKUs</div>
        </div>
        <div class="stat-card-large">
          <div class="stat-big-num">45+</div>
          <div class="stat-big-label">Export Countries</div>
        </div>
        <div class="stat-card-large">
          <div class="stat-big-num">40+</div>
          <div class="stat-big-label">Years of Expertise</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ===== TECHNICAL RESOURCES ===== -->
<section class="resources-section">
  <div class="container">
    <div class="section-header-flex">
      <div>
        <div class="section-eyebrow">Engineering Knowledge</div>
        <h2 class="section-title">Technical Procurement Guides</h2>
      </div>
      <a href="/resources" class="btn btn-outline">All Guides →</a>
    </div>

    <div class="resources-grid">
      <% recentResources.forEach(res => { %>
        <article class="resource-card">
          <div class="resource-category-tag"><%= res.category %></div>
          <h3 class="resource-title">
            <a href="/resources/<%= res.slug %>"><%= res.title %></a>
          </h3>
          <p class="resource-excerpt"><%= res.excerpt %></p>
          <div class="resource-meta">
            <span>📖 <%= res.readingTime %></span>
            <span>by <%= res.author.split(' ').slice(0,3).join(' ') %></span>
          </div>
          <a href="/resources/<%= res.slug %>" class="resource-read-link">Read Guide →</a>
        </article>
      <% }) %>
    </div>
  </div>
</section>


<!-- ===== TRUST & CERTIFICATIONS SECTION ===== -->
<section class="certifications-section" id="certifications">
  <div class="container">
    <div class="cert-section-header">
      <div class="section-eyebrow">Verified &amp; Certified Supplier</div>
      <h2 class="section-title">Government Registered &amp; Quality Accredited</h2>
      <p class="section-subtext">
        RRE International holds valid government export licenses, MSME credentials, and international ISO 9001:2015 accreditation for seamless global trade.
      </p>
    </div>

    <!-- 3 Horizontal Certificate Cards -->
    <div class="cert-cards-horizontal">
      <!-- 1. ISO 9001:2015 -->
      <div class="cert-item-card" id="cert-iso">
        <span class="cert-item-badge iso">🏅 ISO 9001:2015 Certified</span>
        <div class="cert-thumb-frame" onclick="openCertLightbox('/images/cert-iso9001.jpg', 'ISO 9001 : 2015 Quality Management Systems')">
          <img src="/images/cert-iso9001.jpg" alt="ISO 9001:2015 Certificate - RRE International" class="cert-thumb-img" loading="lazy">
          <div class="cert-thumb-overlay">
            <span class="cert-view-btn">🔍 View Full Certificate</span>
          </div>
        </div>
        <div class="cert-meta-info">
          <h3 class="cert-doc-title">ISO 9001 : 2015 QMS</h3>
          <p class="cert-doc-sub">Cert No: <strong>ECI/2512/2983</strong> · Euroswiss Certification Inc., Switzerland. Accredited by GEAC.</p>
        </div>
      </div>

      <!-- 2. IEC (Importer Exporter Code) -->
      <div class="cert-item-card" id="cert-iec">
        <span class="cert-item-badge iec">🇮🇳 Govt. IEC Holder</span>
        <div class="cert-thumb-frame" onclick="openCertLightbox('/images/cert-iec.jpg', 'Importer-Exporter Code (IEC) - Ministry of Commerce &amp; Industry')">
          <img src="/images/cert-iec.jpg" alt="IEC Certificate - RRE International" class="cert-thumb-img" loading="lazy">
          <div class="cert-thumb-overlay">
            <span class="cert-view-btn">🔍 View Full Certificate</span>
          </div>
        </div>
        <div class="cert-meta-info">
          <h3 class="cert-doc-title">Importer-Exporter Code</h3>
          <p class="cert-doc-sub">IEC No: <strong>AXBPJ4236F</strong> · DGFT, Ministry of Commerce &amp; Industry, Government of India.</p>
        </div>
      </div>

      <!-- 3. MSME Udyam -->
      <div class="cert-item-card" id="cert-udyam">
        <span class="cert-item-badge udyam">🏭 MSME Registered</span>
        <div class="cert-thumb-frame" onclick="openCertLightbox('/images/cert-udyam.jpg', 'Udyam Registration Certificate - Ministry of MSME')">
          <img src="/images/cert-udyam.jpg" alt="Udyam Registration Certificate - RRE International" class="cert-thumb-img" loading="lazy">
          <div class="cert-thumb-overlay">
            <span class="cert-view-btn">🔍 View Full Certificate</span>
          </div>
        </div>
        <div class="cert-meta-info">
          <h3 class="cert-doc-title">MSME Udyam Registration</h3>
          <p class="cert-doc-sub">Reg No: <strong>UDYAM-DL-01-0067628</strong> · Ministry of Micro, Small &amp; Medium Enterprises, Govt. of India.</p>
        </div>
      </div>
    </div>
  </div>

  <!-- Lightbox Modal -->
  <div class="cert-lightbox-modal" id="certLightboxModal" onclick="closeCertLightbox()">
    <div class="cert-lightbox-container" onclick="event.stopPropagation()">
      <div class="cert-lightbox-header">
        <span class="cert-lightbox-title" id="certLightboxTitle">Certificate Viewer</span>
        <button class="cert-lightbox-close" onclick="closeCertLightbox()" aria-label="Close modal">✕</button>
      </div>
      <div class="cert-lightbox-body">
        <img id="certLightboxImg" src="" alt="Certificate Document">
      </div>
    </div>
  </div>
</section>

<!-- ===== FINAL RFQ CTA BANNER ===== -->
<section class="rfq-cta-section">
  <div class="container">
    <div class="rfq-cta-card">
      <div class="rfq-cta-content">
        <div class="rfq-cta-eyebrow">🚀 Direct Manufacturer Pricing</div>
        <h2 class="rfq-cta-headline">Ready to Source Direct from the Factory?</h2>
        <p class="rfq-cta-desc">
          Submit your complete Bill of Materials for a wholesale FOB/CIF quotation, or chat directly with our export engineering desk on WhatsApp for urgent part identification and pricing.
        </p>
      </div>
      <div class="rfq-cta-actions">
        <a href="/rfq" class="btn btn-primary btn-xl" id="final-rfq-btn">
          📋 Submit RFQ / Bill of Materials
        </a>
        <a href="https://wa.me/<%= organization.contact.whatsappNumber %>?text=<%= encodeURIComponent('Hello RRE International, I want to discuss a bulk spare parts requirement.') %>"
           class="btn btn-whatsapp btn-xl" id="final-wa-btn" target="_blank" rel="noopener">
          💬 Chat with Export Specialist · <%= organization.contact.phoneDisplay %>
        </a>
      </div>
    </div>
  </div>
</section>
