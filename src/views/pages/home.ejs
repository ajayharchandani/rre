        <circle cx="880" cy="310" r="9" fill="#f59e0b"/>
        <circle cx="880" cy="310" r="5" fill="#fff"/>
        <!-- Label -->
        <rect x="820" y="323" width="120" height="36" rx="6" fill="rgba(15,23,42,0.9)" stroke="#f59e0b" stroke-width="1.2"/>
        <text x="880" y="337" text-anchor="middle" fill="#fbbf24" font-size="10" font-weight="800">📦 Delhi, India</text>
        <text x="880" y="351" text-anchor="middle" fill="#94a3b8" font-size="8.5">RRE Manufacturing HQ</text>
