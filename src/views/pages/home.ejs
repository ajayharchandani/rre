      </g>
      <!-- Kenya -->
      <g class="dest-marker">
        <circle cx="590" cy="400" r="6.5" fill="#10b981" opacity="0.9"/>
        <rect x="547" y="407" width="72" height="18" rx="3" fill="rgba(0,0,0,0.65)"/>
        <text x="583" y="420" text-anchor="middle" fill="#fff" font-size="9.5" font-weight="700">🇰🇪 Kenya</text>
      </g>
      <!-- South Africa -->
      <g class="dest-marker">
        <circle cx="580" cy="490" r="6.5" fill="#34d399" opacity="0.9"/>
        <rect x="522" y="497" width="100" height="18" rx="3" fill="rgba(0,0,0,0.65)"/>
        <text x="572" y="510" text-anchor="middle" fill="#fff" font-size="9.5" font-weight="700">🇿🇦 South Africa</text>
      </g>
      <!-- UK / Europe -->
      <g class="dest-marker">
        <circle cx="560" cy="195" r="6.5" fill="#60a5fa" opacity="0.9"/>
        <rect x="498" y="178" width="90" height="18" rx="3" fill="rgba(0,0,0,0.65)"/>
        <text x="543" y="191" text-anchor="middle" fill="#fff" font-size="9.5" font-weight="700">🇬🇧 UK / Europe</text>
      </g>
      <!-- Australia -->
      <g class="dest-marker">
        <circle cx="1080" cy="420" r="6.5" fill="#c084fc" opacity="0.9"/>
        <rect x="1020" y="403" width="86" height="18" rx="3" fill="rgba(0,0,0,0.65)"/>
        <text x="1063" y="416" text-anchor="middle" fill="#fff" font-size="9.5" font-weight="700">🇦🇺 Australia</text>
      </g>
      <!-- Singapore / SEA -->
      <g class="dest-marker">
        <circle cx="990" cy="345" r="6.5" fill="#a78bfa" opacity="0.9"/>
        <rect x="930" y="328" width="100" height="18" rx="3" fill="rgba(0,0,0,0.65)"/>
        <text x="980" y="341" text-anchor="middle" fill="#fff" font-size="9.5" font-weight="700">🇸🇬 S.E. Asia</text>
      </g>

      <!-- ── ORIGIN MARKER — Delhi, India ── -->
      <g class="origin-marker" filter="url(#originGlow)">
        <!-- Pulsing rings -->
        <circle cx="880" cy="310" r="18" fill="none" stroke="#f59e0b" stroke-width="2" opacity="0.8">
          <animate attributeName="r" values="14;30;14" dur="2s" repeatCount="indefinite"/>
          <animate attributeName="opacity" values="0.8;0;0.8" dur="2s" repeatCount="indefinite"/>
        </circle>
        <circle cx="880" cy="310" r="10" fill="none" stroke="#fbbf24" stroke-width="2" opacity="0.6">
          <animate attributeName="r" values="10;22;10" dur="2s" repeatCount="indefinite" begin="0.4s"/>
          <animate attributeName="opacity" values="0.6;0;0.6" dur="2s" repeatCount="indefinite" begin="0.4s"/>
