<!-- ===== WHATSAPP PHOTO LEAD GEN BANNER ===== -->
<section class="whatsapp-photo-section">
  <div class="container">
    <div class="whatsapp-photo-card">
      <div class="whatsapp-photo-content">
        <div class="whatsapp-badge-pill">⚡ Instant Part Identification</div>
        <h2 class="whatsapp-photo-headline">Can't Find Your Part Number?<br>Send Us a Photo on WhatsApp!</h2>
        <p class="whatsapp-photo-desc">
          Photo of the damaged part or machine serial plate → Our engineering team identifies exact dimensions, matching OEM part numbers, and delivers an instant wholesale FOB/CIF price quote.
        </p>
      </div>
      <div class="whatsapp-photo-cta">
        <a href="https://wa.me/<%= organization.contact.whatsappNumber %>?text=<%= encodeURIComponent('Hello RRE International, I need help identifying a spare part. Sending a photo for verification.') %>"
           class="btn btn-whatsapp btn-xl" id="whatsapp-photo-btn" target="_blank" rel="noopener">
          📸 Send Photo on WhatsApp
        </a>
        <div class="whatsapp-response-tag">⏱ Average response: &lt;15 minutes</div>
      </div>
    </div>
  </div>
</section>

<!-- ===== FAST-MOVING PRODUCTS SECTION ===== -->
<section class="products-section">
  <div class="container">
    <div class="section-header-flex">
      <div>
        <div class="section-eyebrow">Verified Export Inventory</div>
        <h2 class="section-title">Fast-Moving Spare Parts & Components</h2>
      </div>
      <a href="/products" class="btn btn-outline">View All 85,000+ SKUs →</a>
    </div>

    <!-- Category Filter Tabs (real Cat 1 codes from the master price list) -->
    <div class="category-tabs" id="product-tabs">
      <button class="cat-tab active js-cat-tab" data-cat="all" id="tab-all">All</button>
      <% featuredCategories.forEach(cat => { %>
        <button class="cat-tab js-cat-tab" data-cat="<%= cat.slug %>" id="tab-<%= cat.slug %>"><%= cat.shortName %></button>
      <% }) %>
    </div>

    <div class="products-grid" id="products-grid">
      <% products.forEach((prod, idx) => { %>
        <article class="prod-card js-prod-card" data-cat="<%= prod.categorySlug %>" style="animation-delay: <%= (idx % 8) * 60 %>ms">

          <div class="prod-card-img-wrap">
            <img
              src="<%= prod.image || '/images/products/rre-image-coming-soon.png' %>"
              alt="<%= prod.name %> — Part No <%= prod.partNumber %>"
              loading="lazy"
              onerror="this.src='/images/products/rre-image-coming-soon.png'"
            >
          </div>

          <div class="prod-card-body">
            <div class="prod-pn-row">
              <span class="prod-pn-label">PN: <strong><%= prod.partNumber %></strong></span>
              <span class="prod-hsn">HSN <%= prod.hsnCode %></span>
            </div>

            <h3 class="prod-card-title">
              <a href="/products/<%= prod.slug %>"><%= prod.name %></a>
            </h3>

            <p class="prod-card-desc"><%= prod.description.substring(0, 105) %>...</p>

            <div class="prod-card-actions">
              <a href="/products/<%= prod.slug %>" class="btn btn-outline btn-sm" id="prod-specs-<%= prod.id %>">
                Specs & Details
              </a>
              <a href="https://wa.me/<%= organization.contact.whatsappNumber %>?text=<%= encodeURIComponent('Hello RRE International, please share price & availability for Part No. ' + prod.partNumber + ' (' + prod.name + ').') %>"
                 class="btn btn-whatsapp btn-sm" id="prod-wa-<%= prod.id %>" target="_blank" rel="noopener">
                💬 WhatsApp Price
              </a>
            </div>
          </div>

        </article>
      <% }) %>
    </div>

  </div>
</section>

<!-- ===== SUPPORTED MACHINE PLATFORMS ===== -->
<section class="machines-section">
  <div class="container">
    <div class="section-header-center">
      <div class="section-eyebrow">Machinery Coverage</div>
      <h2 class="section-title">Engineered for Benchmark Earthmoving Platforms</h2>
      <p class="section-subtext">Parts matched to exact production year revisions, engine configurations, and hydraulic pump variants.</p>
    </div>

    <div class="machines-grid">
      <% featuredMachines.forEach(mach => { %>
        <div class="machine-card" id="machine-<%= mach.slug %>">
          <div class="machine-card-img">
            <img src="<%= mach.image || '/images/machines/jcb-3dx.jpg' %>" alt="<%= mach.name %>" loading="lazy" onerror="this.src='/images/machines/jcb-3dx.jpg'">
            <span class="machine-brand-badge"><%= mach.brandSlug.toUpperCase() %></span>
          </div>
          <div class="machine-card-body">
            <div class="machine-type-tag"><%= mach.type %></div>
            <h3 class="machine-title">
              <a href="/machines/<%= mach.slug %>"><%= mach.name %></a>
            </h3>
            <p class="machine-desc"><%= mach.description.substring(0, 140) %>...</p>
            <div class="machine-card-footer">
              <a href="/machines/<%= mach.slug %>" class="machine-catalog-link">View Parts Catalog →</a>
              <a href="/rfq?machine=<%= encodeURIComponent(mach.name) %>" class="btn btn-outline btn-sm">RFQ</a>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- ===== 13-CATEGORY COMPONENT TAXONOMY ===== -->
<section class="categories-section">
  <div class="container">
    <div class="section-header-flex">
      <div>
        <div class="section-eyebrow">Component Taxonomy</div>
        <h2 class="section-title">Explore Spare Parts by Machinery System</h2>
      </div>
      <a href="/products" class="btn btn-outline">All Categories →</a>
    </div>

    <!-- Highlighted User-Requested Categories -->
    <div class="featured-category-row">
      <a href="/products/cabin-rubber-parts" class="feat-cat-card feat-cabin" id="feat-cat-cabin">
        <div class="feat-cat-icon">🚐</div>
        <div class="feat-cat-label">Cabin & Mounts</div>
        <div class="feat-cat-sub">Anti-vibration mounts, cabin dampers, hydraulic hoses</div>
      </a>
      <a href="/products/cabin-rubber-parts" class="feat-cat-card feat-rubber" id="feat-cat-rubber">
        <div class="feat-cat-icon">🔵</div>
        <div class="feat-cat-label">Rubber Parts</div>
        <div class="feat-cat-sub">Rubber seals, mounts, engine dampers, door weather strips</div>
      </a>
      <a href="/products/electrical-solenoid" class="feat-cat-card feat-electrical" id="feat-cat-electrical">
        <div class="feat-cat-icon">⚡</div>
        <div class="feat-cat-label">Electrical & Solenoid</div>
        <div class="feat-cat-sub">12V/24V solenoid valves, alternators, wiring harnesses</div>
      </a>
      <a href="/products/fabrication-structural" class="feat-cat-card feat-fabrication" id="feat-cat-fabrication">
        <div class="feat-cat-icon">🏗️</div>
        <div class="feat-cat-label">Fabrication</div>
        <div class="feat-cat-sub">Boom arms, linkage frames, chassis plates, weldments</div>
      </a>
    </div>

    <!-- Full Category Grid -->
    <div class="categories-grid">
      <% featuredCategories.forEach(cat => { %>
        <article class="cat-card" id="cat-<%= cat.slug %>" style="display: flex; flex-direction: column; overflow: hidden; padding: 0; border: 1px solid #e2e8f0; border-radius: 12px; background: #ffffff;">
          <a href="/parts/<%= cat.slug %>" style="display: block; width: 100%; aspect-ratio: 4/3; background: #f8fafc; overflow: hidden; border-bottom: 1px solid #f1f5f9;">
            <img src="<%= cat.image_url %>" alt="<%= cat.image_alt %>" loading="lazy" style="width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.3s ease;">
          </a>
          <div style="padding: 1.25rem; display: flex; flex-direction: column; flex: 1;">
            <h3 class="cat-title" style="margin-bottom: 0.4rem; font-size: 1.15rem;">
              <a href="/parts/<%= cat.slug %>"><%= cat.name %></a>
            </h3>
            <p class="cat-desc" style="margin-bottom: 1rem;"><%= cat.description.substring(0, 100) %>...</p>
            <a href="/parts/<%= cat.slug %>" class="btn btn-outline" style="margin-top: auto; font-size: 0.85rem; text-align: center; justify-content: center; width: 100%;">View Catalog →</a>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</section>

<!-- ===== ANIMATED GLOBAL SHIPPING MAP ===== -->
<section class="shipping-map-section">
  <div class="container">
    <div class="section-header-center" style="margin-bottom:2.5rem;">
      <div class="section-eyebrow" style="color:#fbbf24;">Global Export Network</div>
      <h2 class="section-title" style="color:#fff;">Products Shipped to 45+ Countries</h2>
      <p class="section-subtext" style="color:#94a3b8;">Weekly container sailings from JNPT Nhava Sheva & Mundra Port to GCC, Africa, South-East Asia and beyond.</p>
    </div>
  </div>

  <!-- Full-width animated world map -->
  <div class="shipping-map-canvas" id="shippingMapCanvas">

    <!-- Real world map as background image -->
    <div class="world-map-bg"></div>

    <!-- Animated SVG Overlay -->
    <svg class="shipping-routes-svg" viewBox="0 0 1440 720" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid slice">
      <defs>
        <!-- Glow filter for routes -->
        <filter id="routeGlow">
          <feGaussianBlur stdDeviation="2.5" result="blur"/>
          <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
        </filter>
        <!-- Glow for origin pulse -->
        <filter id="originGlow">
          <feGaussianBlur stdDeviation="4" result="blur"/>
          <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
        </filter>
        <!-- Route gradient — orange to destination -->
        <linearGradient id="routeGradUAE" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="#f59e0b" stop-opacity="0.9"/>
          <stop offset="100%" stop-color="#ef4444" stop-opacity="0.7"/>
        </linearGradient>
        <linearGradient id="routeGradAfrica" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="#f59e0b" stop-opacity="0.9"/>
          <stop offset="100%" stop-color="#10b981" stop-opacity="0.7"/>
        </linearGradient>
        <linearGradient id="routeGradEurope" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="#f59e0b" stop-opacity="0.9"/>
          <stop offset="100%" stop-color="#3b82f6" stop-opacity="0.7"/>
        </linearGradient>
        <linearGradient id="routeGradAsia" x1="0" y1="0" x2="1" y2="0">
          <stop offset="0%" stop-color="#f59e0b" stop-opacity="0.9"/>
          <stop offset="100%" stop-color="#a78bfa" stop-opacity="0.7"/>
        </linearGradient>
      </defs>

      <!-- ── SHIPPING ROUTES (curved paths from Delhi) ── -->
      <!-- Delhi → UAE (Dubai) -->
      <path class="ship-route route-gcc" d="M 880 310 Q 790 240 710 295" fill="none" stroke="url(#routeGradUAE)" stroke-width="2"/>
      <!-- Delhi → Saudi Arabia -->
      <path class="ship-route route-gcc" d="M 880 310 Q 780 255 690 305" fill="none" stroke="url(#routeGradUAE)" stroke-width="1.5"/>
      <!-- Delhi → Qatar -->
      <path class="ship-route route-gcc" d="M 880 310 Q 800 230 720 280" fill="none" stroke="url(#routeGradUAE)" stroke-width="1.5"/>
      <!-- Delhi → Oman -->
      <path class="ship-route route-gcc" d="M 880 310 Q 820 295 760 330" fill="none" stroke="url(#routeGradUAE)" stroke-width="1.5"/>
      <!-- Delhi → Nigeria (sea — around India, through Red Sea, Atlantic) -->
      <path class="ship-route route-africa" d="M 880 310 Q 760 370 640 350 Q 560 340 520 370 Q 490 390 468 380" fill="none" stroke="url(#routeGradAfrica)" stroke-width="2"/>
      <!-- Delhi → Kenya -->
      <path class="ship-route route-africa" d="M 880 310 Q 800 370 740 360 Q 680 355 640 370 Q 600 385 590 400" fill="none" stroke="url(#routeGradAfrica)" stroke-width="1.5"/>
      <!-- Delhi → South Africa -->
      <path class="ship-route route-africa" d="M 880 310 Q 830 400 780 420 Q 720 445 680 460 Q 620 480 580 490" fill="none" stroke="url(#routeGradAfrica)" stroke-width="1.5"/>
      <!-- Delhi → UK / Europe -->
      <path class="ship-route route-europe" d="M 880 310 Q 820 250 750 230 Q 680 210 650 210 Q 600 210 560 195" fill="none" stroke="url(#routeGradEurope)" stroke-width="1.5" stroke-dasharray="6,4"/>
      <!-- Delhi → Australia -->
      <path class="ship-route route-asia" d="M 880 310 Q 970 370 1010 390 Q 1050 410 1080 420" fill="none" stroke="url(#routeGradAsia)" stroke-width="1.5" stroke-dasharray="6,4"/>
      <!-- Delhi → Malaysia/Singapore -->
      <path class="ship-route route-asia" d="M 880 310 Q 950 330 990 345" fill="none" stroke="url(#routeGradAsia)" stroke-width="1.5"/>
      <!-- Delhi → Bangladesh/Myanmar -->
      <path class="ship-route route-asia" d="M 880 310 Q 930 300 955 295" fill="none" stroke="url(#routeGradAsia)" stroke-width="1.5"/>

      <!-- ── ANIMATED CARGO DOTS on routes ── -->
      <!-- UAE route dot -->
      <circle class="cargo-dot dot-gcc" r="5" fill="#fbbf24" filter="url(#routeGlow)">
        <animateMotion dur="4s" repeatCount="indefinite" begin="0s">
          <mpath href="#routeUAE"/>
        </animateMotion>
      </circle>
      <!-- Inline path refs for animateMotion -->
      <path id="routeUAE" d="M 880 310 Q 790 240 710 295" fill="none"/>
      <path id="routeSaudi" d="M 880 310 Q 780 255 690 305" fill="none"/>
      <path id="routeNigeria" d="M 880 310 Q 760 370 640 350 Q 560 340 520 370 Q 490 390 468 380" fill="none"/>
      <path id="routeKenya" d="M 880 310 Q 800 370 740 360 Q 680 355 640 370 Q 600 385 590 400" fill="none"/>
      <path id="routeSAfrica" d="M 880 310 Q 830 400 780 420 Q 720 445 680 460 Q 620 480 580 490" fill="none"/>
      <path id="routeEurope" d="M 880 310 Q 820 250 750 230 Q 680 210 650 210 Q 600 210 560 195" fill="none"/>
      <path id="routeAustralia" d="M 880 310 Q 970 370 1010 390 Q 1050 410 1080 420" fill="none"/>
      <path id="routeSingapore" d="M 880 310 Q 950 330 990 345" fill="none"/>

      <!-- cargo dot — UAE -->
      <circle r="5" fill="#f59e0b" filter="url(#routeGlow)">
        <animateMotion dur="3.5s" repeatCount="indefinite" begin="0s"><mpath href="#routeUAE"/></animateMotion>
        <animate attributeName="opacity" values="0;1;1;0" dur="3.5s" repeatCount="indefinite"/>
      </circle>
      <!-- cargo dot — Saudi (delayed) -->
      <circle r="4" fill="#fb923c" filter="url(#routeGlow)">
        <animateMotion dur="4s" repeatCount="indefinite" begin="1.2s"><mpath href="#routeSaudi"/></animateMotion>
        <animate attributeName="opacity" values="0;1;1;0" dur="4s" repeatCount="indefinite" begin="1.2s"/>
      </circle>
      <!-- cargo dot — Nigeria (sea, slow) -->
      <circle r="5" fill="#10b981" filter="url(#routeGlow)">
        <animateMotion dur="7s" repeatCount="indefinite" begin="0.5s"><mpath href="#routeNigeria"/></animateMotion>
        <animate attributeName="opacity" values="0;1;1;0" dur="7s" repeatCount="indefinite" begin="0.5s"/>
      </circle>
      <!-- cargo dot — Kenya -->
      <circle r="4" fill="#34d399" filter="url(#routeGlow)">
        <animateMotion dur="6s" repeatCount="indefinite" begin="2s"><mpath href="#routeKenya"/></animateMotion>
        <animate attributeName="opacity" values="0;1;1;0" dur="6s" repeatCount="indefinite" begin="2s"/>
      </circle>
      <!-- cargo dot — South Africa (long) -->
      <circle r="4" fill="#6ee7b7" filter="url(#routeGlow)">
        <animateMotion dur="8.5s" repeatCount="indefinite" begin="3s"><mpath href="#routeSAfrica"/></animateMotion>
        <animate attributeName="opacity" values="0;1;1;0" dur="8.5s" repeatCount="indefinite" begin="3s"/>
      </circle>
      <!-- cargo dot — Europe -->
      <circle r="4" fill="#60a5fa" filter="url(#routeGlow)">
        <animateMotion dur="6.5s" repeatCount="indefinite" begin="1.8s"><mpath href="#routeEurope"/></animateMotion>
        <animate attributeName="opacity" values="0;1;1;0" dur="6.5s" repeatCount="indefinite" begin="1.8s"/>
      </circle>
      <!-- cargo dot — Australia -->
      <circle r="4" fill="#c084fc" filter="url(#routeGlow)">
        <animateMotion dur="5s" repeatCount="indefinite" begin="0.9s"><mpath href="#routeAustralia"/></animateMotion>
        <animate attributeName="opacity" values="0;1;1;0" dur="5s" repeatCount="indefinite" begin="0.9s"/>
      </circle>
      <!-- cargo dot — Singapore -->
      <circle r="4" fill="#a78bfa" filter="url(#routeGlow)">
