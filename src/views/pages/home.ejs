<!-- src/views/pages/home.ejs -->

<!-- ===== HERO SECTION — SEARCH-FIRST PREMIUM B2B ===== -->
<section class="hero-section-light">
  <div class="hero-bg-slideshow">
    <div class="hero-bg-slide active" style="background-image: url('/images/hero/slide-2.jpg');"></div>
    <div class="hero-bg-slide" style="background-image: url('/images/hero/slide-1.jpg');"></div>
    <div class="hero-bg-slide" style="background-image: url('/images/hero/slide-3.jpg');"></div>
    <div class="hero-bg-slide" style="background-image: url('/images/hero/slide-4.jpg');"></div>
  </div>
  <div class="hero-overlay"></div>

  <div class="container hero-content-wrap">

    <!-- Trust Badges Row -->
    <div class="hero-trust-row" data-animate="fadeInDown">
      <span class="trust-chip gold">★ Est. 1984</span>
      <span class="trust-chip green">✓ ISO 9001:2015 · ECI/2512/2983</span>
      <span class="trust-chip blue">🌍 Exporting to 45+ Countries</span>
      <span class="trust-chip gray">85,000+ Verified SKUs</span>
    </div>

    <!-- Main Headline -->
    <h1 class="hero-headline" data-animate="fadeInUp">
      High-Precision Replacement Spare Parts<br>
      <span class="hero-headline-accent">for Heavy Earthmoving Machinery</span>
    </h1>

    <p class="hero-subline" data-animate="fadeInUp" data-delay="100">
      Direct manufacturer from <strong>Delhi, India</strong>. Engineered to exact OEM tolerances for
      <strong>JCB 3DX · Caterpillar 424 · Case 770 · Komatsu PC200</strong>.
      Worldwide container consolidation with FOB / CIF pricing.
    </p>

    <!-- PRIMARY SEARCH ENGINE -->
    <div class="hero-search-card" data-animate="fadeInUp" data-delay="200">
      <div class="hero-search-label">🔍 Search by Part Number, Product, Machine or Brand</div>
      <form action="/search" method="GET" class="hero-search-form" id="hero-search-form">
        <input
          type="text"
          name="q"
          id="hero-search-input"
          class="hero-search-input js-search-input"
          placeholder="Enter part number e.g. 335/Y1459, 991/00147, 123/06014, 458/M1047..."
          autocomplete="off"
          aria-label="Search part numbers and spare parts"
        >
        <button type="submit" class="hero-search-btn" id="hero-search-btn">
          Search Catalog →
        </button>
      </form>
      <div class="hero-quick-links">
        <span class="quick-links-label">Fast-Moving SKUs:</span>
        <a href="/parts/335-y1459" class="hero-quick-chip">335/Y1459 — Hydraulic Pump</a>
        <a href="/parts/991-00147" class="hero-quick-chip">991/00147 — Boom Seal Kit</a>
        <a href="/parts/123-06014" class="hero-quick-chip">123/06014 — King Pin</a>
        <a href="/parts/458-m1047" class="hero-quick-chip">458/M1047 — Crown Wheel</a>
      </div>
    </div>

    <!-- Dual CTA Row -->
    <div class="hero-cta-row" data-animate="fadeInUp" data-delay="300">
      <a href="/rfq" class="btn btn-primary btn-lg" id="hero-rfq-cta">
        📋 Submit Bill of Materials (RFQ)
      </a>
      <a href="https://wa.me/<%= organization.contact.whatsappNumber %>?text=<%= encodeURIComponent('Hello RRE International, I need price & availability for earthmoving spare parts. Please assist.') %>"
         class="btn btn-whatsapp btn-lg" id="hero-whatsapp-cta" target="_blank" rel="noopener">
        💬 WhatsApp Export Desk · <%= organization.contact.phoneDisplay %>
      </a>
    </div>

  </div>

  <!-- Slide dots -->
  <div class="hero-slide-dots">
    <button class="slide-dot active js-slide-dot" data-slide="0" aria-label="Slide 1"></button>
    <button class="slide-dot js-slide-dot" data-slide="1" aria-label="Slide 2"></button>
    <button class="slide-dot js-slide-dot" data-slide="2" aria-label="Slide 3"></button>
    <button class="slide-dot js-slide-dot" data-slide="3" aria-label="Slide 4"></button>
  </div>
</section>

<!-- ===== BRAND & TRUST CREDIBILITY BAR ===== -->
<section class="brand-credibility-bar">
  <div class="container">
    <div class="credibility-label">OEM-Compatible Replacement Parts Engineered For:</div>
    <div class="brand-pills-row">
      <div class="brand-pill-item">
        <span class="brand-pill-logo jcb-pill">JCB</span>
        <span class="brand-pill-name">3DX · 4DX · JS200</span>
      </div>
      <div class="brand-pill-divider"></div>
      <div class="brand-pill-item">
        <span class="brand-pill-logo cat-pill">CAT</span>
        <span class="brand-pill-name">424 · 424B · 424D</span>
      </div>
      <div class="brand-pill-divider"></div>
      <div class="brand-pill-item">
        <span class="brand-pill-logo case-pill">CASE</span>
        <span class="brand-pill-name">770 · 770EX · 851EX</span>
      </div>
      <div class="brand-pill-divider"></div>
      <div class="brand-pill-item">
        <span class="brand-pill-logo komatsu-pill">KOMATSU</span>
        <span class="brand-pill-name">PC200 · PC210 · PC300</span>
      </div>
      <div class="brand-pill-divider"></div>
      <div class="brand-pill-item">
        <span class="brand-pill-logo volvo-pill">VOLVO</span>
        <span class="brand-pill-name">EC160 · EC210 Series</span>
      </div>
      <div class="brand-pill-divider"></div>
      <div class="brand-pill-item">
        <span class="brand-pill-logo perkins-pill">PERKINS</span>
