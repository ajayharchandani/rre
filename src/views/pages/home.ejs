      </g>
      <!-- Nigeria -->
      <g class="dest-marker">
        <circle cx="468" cy="380" r="7" fill="#10b981" opacity="0.9" filter="url(#routeGlow)"/>
        <circle cx="468" cy="380" r="13" fill="none" stroke="#10b981" stroke-width="1.5" opacity="0.4">
          <animate attributeName="r" values="7;16;7" dur="3s" repeatCount="indefinite" begin="1s"/>
          <animate attributeName="opacity" values="0.6;0;0.6" dur="3s" repeatCount="indefinite" begin="1s"/>
        </circle>
        <rect x="414" y="355" width="84" height="18" rx="4" fill="rgba(0,0,0,0.65)"/>
