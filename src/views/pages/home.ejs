      </div>
      <div class="assurance-strip-item">
        <div class="assurance-icon">🇮🇳</div>
        <div>
          <div class="assurance-title">Direct Manufacturer — India</div>
          <div class="assurance-sub">In-House CNC Machining & Heat Treatment</div>
        </div>
      </div>
      <div class="assurance-strip-item">
        <div class="assurance-icon">🚢</div>
        <div>
          <div class="assurance-title">Weekly Ocean Freight</div>
