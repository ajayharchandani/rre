<%- include('../partials/breadcrumbs') %>
<section style="padding: 4rem 0;">
  <div class="container" style="max-width: 820px;">
    <h1 style="font-size: 2.25rem; margin-bottom: 1.5rem;">Privacy Policy</h1>
    <div style="font-size: 1rem; color: #334155; line-height: 1.8;">
      <p>RRE International respects the privacy of our international B2B clients and visitors. This policy outlines our data handling practices.</p>
      <h2 style="font-size: 1.3rem; margin: 1.5rem 0 0.5rem;">Information Collection</h2>
      <p>We collect information submitted via our Request for Quotation (RFQ) forms, direct emails, and WhatsApp communications solely for the purpose of preparing commercial quotations, logistics coordination, and export compliance.</p>
      <h2 style="font-size: 1.3rem; margin: 1.5rem 0 0.5rem;">Data Protection</h2>
      <p>We do not sell, lease, or share customer contact details or parts lists with third-party marketing entities. Uploaded technical drawings and Bills of Materials (BOMs) remain strictly confidential.</p>
    </div>
  </div>
</section>
