<!-- src/views/pages/category-detail.ejs -->
<%- include('../partials/breadcrumbs') %>

<section style="padding: 3.5rem 0; background: #0f172a; color: #ffffff;">
  <div class="container">
    <div style="display: flex; justify-content: space-between; align-items: center; gap: 2rem; flex-wrap: wrap;">
      <div style="max-width: 700px;">
        <span class="badge badge-brand" style="margin-bottom: 1rem;">Category</span>
        <h1 style="font-size: 2.25rem; color: #ffffff; margin-bottom: 1rem;"><%= category.name %> — JCB Spare Parts</h1>
        <% if (category.description) { %>
          <p style="color: #e2e8f0; font-size: 1.1rem; line-height: 1.6; margin-bottom: 0.75rem;">
            <%= category.description %>
          </p>
        <% } %>
        <p style="color: #cbd5e1; font-size: 1rem; line-height: 1.6; margin-bottom: 1.5rem;">
          <%= pagination.total.toLocaleString('en-IN') %> listings in RRE International's JCB replacement parts catalogue.
          Request export pricing and availability by part number.
        </p>

        <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
          <a href="/rfq?product=<%= encodeURIComponent(category.name + ' spare parts') %>" class="btn btn-primary">
            Request <%= category.name %> Quotation
          </a>
          <a href="https://wa.me/<%= organization.contact.whatsappNumber %>?text=<%= encodeURIComponent('Hello RRE International, I need price and availability for category ' + category.name + '.') %>" class="btn btn-whatsapp" target="_blank" rel="noopener">
            WhatsApp Fast Quote (<%= organization.contact.phoneDisplay %>)
          </a>
        </div>
      </div>

      <div style="flex-shrink: 0; background: rgba(255,255,255,0.06); padding: 0.75rem; border-radius: 12px; border: 1px solid rgba(255,255,255,0.12); box-shadow: 0 8px 24px rgba(0,0,0,0.25);">
        <img src="<%= category.image_url || '/images/categories/' + category.slug + '.webp' %>" alt="<%= category.name %> Spare Parts" width="240" height="160" style="max-height: 160px; max-width: 240px; width: auto; height: auto; object-fit: cover; border-radius: 8px; display: block;" onerror="this.parentElement.style.display='none';">
      </div>
    </div>
  </div>
</section>

<!-- Category Products Grid -->
<section style="padding: 4rem 0;">
  <div class="container">
    <h2 style="font-size: 1.85rem; margin-bottom: 0.5rem; color: #0f172a;"><%= category.name %> Parts</h2>
    <p style="color: #64748b; margin-bottom: 2rem;">
      Showing <%= categoryProducts.length %> of <%= pagination.total.toLocaleString('en-IN') %> — page <%= pagination.page %> of <%= pagination.totalPages %>
    </p>

    <% if (categoryProducts && categoryProducts.length > 0) { %>
      <div class="grid-cards">
        <% categoryProducts.forEach(prod => { %>
          <article class="product-card">

            <div class="product-card-img-wrap">
              <img src="<%= prod.image_url || '/images/products/rre-image-coming-soon.png' %>" alt="<%= prod.description %> — JCB Part No. <%= prod.part_number %>" loading="lazy" onerror="this.onerror=null;this.src='/images/products/rre-image-coming-soon.png';">
            </div>

            <div class="product-card-body">
              <div style="font-family: monospace; font-weight: 800; color: #0f172a; font-size: 0.95rem; margin-bottom: 0.35rem;">
                PN: <%= prod.part_number %>
              </div>

              <h3 class="product-card-title">
                <a href="/products/<%= prod.slug %>"><%= prod.description %></a>
              </h3>

              <div style="display: grid; grid-template-columns: 1fr 1.2fr; gap: 0.5rem; margin-top: auto; border-top: 1px solid #f1f5f9; padding-top: 0.75rem;">
                <a href="/products/<%= prod.slug %>" class="btn btn-outline" style="font-size: 0.82rem; padding: 0.45rem;">
                  Details
                </a>
                <a href="https://wa.me/<%= organization.contact.whatsappNumber %>?text=<%= encodeURIComponent('Hello RRE International, please share price & availability for Part No. ' + prod.part_number + ' (' + prod.description + ').') %>" class="btn btn-whatsapp" style="font-size: 0.82rem; padding: 0.45rem;" target="_blank" rel="noopener">
                  💬 WhatsApp
                </a>
              </div>
            </div>

          </article>
        <% }) %>
      </div>

      <!-- Pagination -->
      <% if (pagination.totalPages > 1) { %>
        <nav aria-label="Category pagination" style="display: flex; justify-content: center; gap: 0.5rem; margin-top: 3rem; flex-wrap: wrap;">
          <% if (pagination.page > 1) { %>
            <a href="<%= pagination.baseUrl %>?page=<%= pagination.page - 1 %>" class="btn btn-outline" style="font-size: 0.85rem;">← Previous</a>
          <% } %>
          <span style="align-self: center; font-size: 0.9rem; color: #64748b;">Page <%= pagination.page %> of <%= pagination.totalPages %></span>
          <% if (pagination.page < pagination.totalPages) { %>
            <a href="<%= pagination.baseUrl %>?page=<%= pagination.page + 1 %>" class="btn btn-outline" style="font-size: 0.85rem;">Next →</a>
          <% } %>
        </nav>
      <% } %>
    <% } else { %>
      <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 3rem; text-align: center;">
        <p style="color: #64748b; font-size: 1rem; margin-bottom: 1.5rem;">
          No listings currently published under this category.
        </p>
        <a href="/rfq?product=<%= encodeURIComponent(category.name + ' spare parts') %>" class="btn btn-primary">
          Submit Requirements
        </a>
      </div>
    <% } %>

    <!-- Internal Linking Navigation -->
    <div style="margin-top: 4rem; padding-top: 3rem; border-top: 1px solid #e2e8f0;">
      <h2 style="font-size: 1.35rem; margin-bottom: 1.25rem;">All JCB Spare Parts Categories</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 0.75rem;">
        <% internalLinks.otherCategories.forEach(c => { %>
          <a href="<%= c.url %>" style="display: block; padding: 0.85rem 1rem; border: 1px solid #e2e8f0; border-radius: 8px; text-decoration: none; background: #fff;">
            <span style="display: block; font-weight: 700; color: #0f172a; font-size: 0.92rem;"><%= c.name %></span>
            <% if (c.count) { %><span style="display: block; font-size: 0.8rem; color: #64748b; margin-top: 0.1rem;"><%= c.count.toLocaleString('en-IN') %> listings</span><% } %>
          </a>
        <% }) %>
      </div>
      <div style="margin-top: 2rem; display: flex; gap: 0.75rem; flex-wrap: wrap;">
        <a href="/machines/jcb-3dx" class="btn btn-outline" style="font-size: 0.85rem;">JCB 3DX parts →</a>
        <a href="/machines/jcb-js200" class="btn btn-outline" style="font-size: 0.85rem;">JCB JS200 / JS210 parts →</a>
        <a href="/machines" class="btn btn-outline" style="font-size: 0.85rem;">All machine platforms →</a>
      </div>
    </div>

  </div>
</section>
