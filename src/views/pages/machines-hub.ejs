<!-- src/views/pages/machines-hub.ejs -->
<%- include('../partials/breadcrumbs') %>

<section style="padding: 3.5rem 0; background: #0f172a; color: #ffffff;">
  <div class="container">
    <span class="badge badge-brand" style="margin-bottom: 1rem;">Machinery Coverage</span>
    <h1 style="font-size: 2.35rem; color: #ffffff; margin-bottom: 0.75rem;">Heavy Earthmoving Machinery Models & Platforms</h1>
    <p style="color: #cbd5e1; font-size: 1.1rem; max-width: 840px; line-height: 1.6;">
      Explore precision replacement spare parts engineered for specific backhoe loader, wheeled loader, and tracked excavator platforms across JCB, Caterpillar, Case, and Komatsu.
    </p>
  </div>
</section>

<section style="padding: 4.5rem 0; background: #ffffff;">
  <div class="container">
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); gap: 2rem;">
      <% machines.forEach(m => { %>
        <article class="machine-platform-card">
          <div class="machine-platform-card-img">
            <img src="<%= m.image || '/images/machines/jcb-3dx.jpg' %>" alt="<%= m.name %>" loading="lazy">
            <span style="position: absolute; top: 12px; left: 12px; z-index: 2;" class="badge badge-brand">
              <%= m.brandSlug.toUpperCase() %>
            </span>
          </div>

          <div style="padding: 1.5rem; display: flex; flex-direction: column; flex: 1;">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
              <span style="font-size: 0.8rem; color: #64748b; font-weight: 700;"><%= m.type %></span>
            </div>
            <h2 style="font-size: 1.35rem; margin-bottom: 0.5rem;">
              <a href="/machines/<%= m.slug %>" style="color: #0f172a;"><%= m.name %></a>
            </h2>
            <p style="font-size: 0.9rem; color: #64748b; margin-bottom: 1.5rem; flex: 1; line-height: 1.55;">
              <%= m.description %>
            </p>
            <div style="border-top: 1px solid #f1f5f9; padding-top: 1.25rem; display: flex; justify-content: space-between; align-items: center;">
              <a href="/machines/<%= m.slug %>" class="btn btn-primary" style="font-size: 0.88rem; padding: 0.55rem 1rem;">
                Explore <%= m.name %> Spares →
              </a>
              <a href="/rfq?machine=<%= encodeURIComponent(m.name) %>" class="btn btn-outline" style="font-size: 0.82rem; padding: 0.45rem 0.85rem;">
                RFQ
              </a>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
  </div>
</section>
