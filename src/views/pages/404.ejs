<!-- src/views/pages/404.ejs -->
<%- include('../partials/breadcrumbs') %>

<section style="padding: 5rem 0; background: #f8fafc; text-align: center;">
  <div class="container" style="max-width: 680px;">
    <div style="background: #ffffff; border: 1px solid #e2e8f0; border-radius: 8px; padding: 3.5rem 2rem; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
      
      <div style="font-size: 4rem; font-weight: 800; color: #d97706; margin-bottom: 0.5rem; font-family: monospace;">404</div>
      <h1 style="font-size: 1.75rem; color: #0f172a; margin-bottom: 1rem;">Page or Part Number Not Found</h1>
      <p style="color: #64748b; font-size: 1rem; line-height: 1.6; margin-bottom: 2rem;">
        The requested URL <code><%= requestedUrl %></code> was not found. Try searching our 85,000+ spare parts catalog or contact our export desk directly.
      </p>

      <!-- Search Bar -->
      <div style="margin-bottom: 2rem;">
        <form action="/search" method="GET" class="search-input-group">
          <input type="text" name="q" class="search-input js-search-input" placeholder="Search Part No. or Product...">
          <button type="submit" class="search-btn">Search</button>
        </form>
      </div>

      <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap;">
        <a href="/" class="btn btn-primary">
          ← Return to Homepage
        </a>
        <a href="https://wa.me/<%= organization.contact.whatsappNumber %>?text=<%= encodeURIComponent('Hello RRE International, I was looking for a part at ' + requestedUrl + ' but reached a 404. Can you help?') %>" class="btn btn-whatsapp" target="_blank" rel="noopener">
          💬 Ask Export Desk on WhatsApp
        </a>
      </div>

    </div>
  </div>
</section>
