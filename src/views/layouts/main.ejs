<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <title><%= seo.title %></title>
  <meta name="description" content="<%= seo.description %>">
  <meta name="robots" content="<%= seo.robots %>">
  <link rel="canonical" href="<%= seo.canonical %>">
  <% var ogType = (seo.openGraph && seo.openGraph.type) || seo.type || 'website'; %>
  <% var ogImage = (seo.openGraph && seo.openGraph.image) || seo.image || ((locals.site && site.defaultOgImage) || ''); %>

  <!-- OpenGraph & Twitter Social Meta -->
  <meta property="og:title" content="<%= seo.title %>">
  <meta property="og:description" content="<%= seo.description %>">
  <meta property="og:url" content="<%= seo.canonical %>">
  <meta property="og:site_name" content="<%= organization.name %>">
  <meta property="og:type" content="<%= ogType %>">
  <% if (ogImage) { %><meta property="og:image" content="<%= ogImage %>">
  <meta property="og:image:alt" content="<%= seo.imageAlt || seo.title %>"><% } %>
  <% if (ogType === 'article' && seo.publishedTime) { %><meta property="article:published_time" content="<%= seo.publishedTime %>"><% } %>
  <% if (ogType === 'article' && (seo.modifiedTime || seo.publishedTime)) { %><meta property="article:modified_time" content="<%= seo.modifiedTime || seo.publishedTime %>"><% } %>

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%= seo.title %>">
  <meta name="twitter:description" content="<%= seo.description %>">
  <% if (ogImage) { %><meta name="twitter:image" content="<%= ogImage %>"><% } %>

  <% if (locals.site && site.gscVerification) { %><meta name="google-site-verification" content="<%= site.gscVerification %>"><% } %>
  <% if (locals.site && site.bingVerification) { %><meta name="msvalidate.01" content="<%= site.bingVerification %>"><% } %>

  <!-- Favicon & Stylesheet -->
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="icon" type="image/svg+xml" href="/images/favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png">
  <link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
  <!-- Google Fonts: Inter — Premium B2B Typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap">
  <link rel="stylesheet" href="/css/style.css">

  <style>
    /* Critical paint CSS — hero appears immediately */
    .hero-section-light { position:relative; width:100%; min-height:640px; display:flex; align-items:center; overflow:hidden; background:#0f172a; }
    .hero-bg-slide { position:absolute; inset:0; background-size:cover; background-position:center; opacity:0; transition:opacity 1.2s ease-in-out; }
    .hero-bg-slide.active { opacity:1; }
    .hero-overlay { position:absolute; inset:0; background:linear-gradient(160deg,rgba(9,13,22,0.88) 0%,rgba(15,23,42,0.82) 60%,rgba(30,41,59,0.75) 100%); z-index:1; }
    .hero-content-wrap { position:relative; z-index:2; padding:4rem 1.5rem; text-align:center; width:100%; }
    body { font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
  </style>

  <!-- Schema.org JSON-LD Structured Data Schemas -->
  <% if (seo.schemas && seo.schemas.length > 0) { %>
    <% seo.schemas.forEach(schema => { %>
      <script type="application/ld+json">
        <%- JSON.stringify(schema, null, 2) %>
      </script>
    <% }) %>
  <% } %>

  <% if (locals.site && site.ga4MeasurementId) { %>
  <!-- Google Analytics 4 -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=<%= site.ga4MeasurementId %>"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '<%= site.ga4MeasurementId %>');
  </script>
  <% } %>
</head>
<body>

  <!-- Top Trust & Quick Contact Strip -->
  <div class="top-trust-strip">
    <div class="container top-trust-inner">
      <div style="display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;">
        <span class="trust-strip-iso"><strong style="color: #fbbf24;">★ ISO 9001:2015 Certified</strong> <span class="trust-strip-iso-suffix">Manufacturer &amp; Exporter (Delhi, India)</span></span>
        <span class="trust-strip-export-claim" style="color: #475569;">|</span>
        <span class="trust-strip-export-claim">Exporting to <strong>45+ Countries</strong> (UAE, Saudi, Africa, Worldwide)</span>
      </div>
      <div style="display: flex; align-items: center; gap: 1.25rem;">
        <a href="https://wa.me/<%= organization.contact.whatsappNumber %>?text=<%= encodeURIComponent('Hello RRE International, I need price and availability for earthmoving spare parts.') %>" class="trust-strip-whatsapp" style="color: #25d366; font-weight: 700; display: inline-flex; align-items: center; gap: 0.35rem;" target="_blank" rel="noopener">
          <span>💬 WhatsApp: <%= organization.contact.phoneDisplay %></span>
        </a>
        <a href="mailto:<%= organization.contact.email %>" class="trust-strip-email" style="color: #cbd5e1;">
          ✉️ <%= organization.contact.email %>
        </a>
      </div>
    </div>
  </div>

  <!-- Main Site Header -->
  <%- include('../partials/header') %>

  <!-- Main Application Body -->
  <main id="main-content">
    <%- body %>
  </main>

  <!-- Main Site Footer -->
  <%- include('../partials/footer') %>

  <!-- Mobile Sticky Bottom Conversion Bar -->
  <div id="mobile-sticky-bar">
    <a href="/rfq" class="btn btn-primary" style="flex: 1; font-size: 0.85rem; padding: 0.6rem;">
      📋 Submit RFQ
    </a>
    <a href="https://wa.me/<%= organization.contact.whatsappNumber %>?text=<%= encodeURIComponent('Hello RRE International, I need an urgent quotation for spare parts.') %>" class="btn btn-whatsapp" style="flex: 1; font-size: 0.85rem; padding: 0.6rem;" target="_blank" rel="noopener">
      💬 WhatsApp Quote
    </a>
  </div>

  <!-- Floating Pulsating WhatsApp Conversion Engine -->
  <a href="https://wa.me/<%= organization.contact.whatsappNumber %>?text=<%= encodeURIComponent('Hello RRE International, I am on your website and would like to check spare parts availability and export pricing.') %>" 
     class="floating-whatsapp-btn" 
     target="_blank" 
     rel="noopener" 
     aria-label="Chat on WhatsApp with RRE Export Desk (+91 97190 48494)">
    <svg xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path>
    </svg>
    <span class="floating-whatsapp-badge">1</span>
  </a>

  <!-- Frontend Client Scripts -->
  <script src="/js/main.js" defer></script>

  <% if (locals.site && site.ga4MeasurementId) { %>
  <script>
    // Report WhatsApp / RFQ intent to GA4 as conversions.
    document.addEventListener('click', function (e) {
      var a = e.target.closest && e.target.closest('a');
      if (!a || typeof gtag !== 'function') return;
      var href = a.getAttribute('href') || '';
      if (/wa\.me|api\.whatsapp\.com|whatsapp:/i.test(href)) {
        gtag('event', 'whatsapp_click', { link_url: href, page_path: location.pathname });
      } else if (href.indexOf('/rfq') === 0) {
        gtag('event', 'rfq_start', { page_path: location.pathname });
      }
    }, true);
  </script>
  <% } %>

</body>
</html>
