<!-- src/views/partials/breadcrumbs.ejs -->
<% if (typeof seo !== 'undefined' && seo.breadcrumbs && Array.isArray(seo.breadcrumbs) && seo.breadcrumbs.length > 0) { 
     const crumbs = seo.breadcrumbs;
%>
<nav class="breadcrumb-nav" aria-label="Breadcrumb">
  <div class="container">
    <ol class="breadcrumb-list" itemscope itemtype="https://schema.org/BreadcrumbList">
      
      <li class="breadcrumb-item" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
        <a href="/" class="breadcrumb-link" itemprop="item">
          <span itemprop="name">Home</span>
        </a>
        <meta itemprop="position" content="1" />
      </li>

      <% crumbs.forEach((crumb, idx) => { 
           const isLast = (idx === crumbs.length - 1);
      %>
        <li class="breadcrumb-item <%= isLast ? 'active' : '' %>" itemprop="itemListElement" itemscope itemtype="https://schema.org/ListItem">
          <% if (isLast) { %>
            <span class="breadcrumb-current" itemprop="name" aria-current="page"><%= crumb.name %></span>
          <% } else { %>
            <a href="<%= crumb.url %>" class="breadcrumb-link" itemprop="item">
              <span itemprop="name"><%= crumb.name %></span>
            </a>
          <% } %>
          <meta itemprop="position" content="<%= idx + 2 %>" />
        </li>
      <% }) %>

    </ol>
  </div>
</nav>
<% } %>
