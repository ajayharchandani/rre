node_modules/
storage/rfq-uploads/*
!storage/rfq-uploads/.gitkeep
test-results/
scratch/
*.log
scripts/__pycache__/
scripts/.pdf-image-staging/
.claude/

# MCP server config — contains the Hostinger API token, never commit
.mcp.json

# Environment variables — contains SMTP credentials, never commit
.env
.env.*
!.env.example

# Secrets & credentials — never commit
*.pem
*.key
*.p12
*.pfx
*.crt
id_rsa*
.npmrc
secrets*.json
credentials*.json
*.credentials
service-account*.json

# Local pipeline inputs / intermediates — not needed to run or deploy the site
storage/source_photos/
storage/generated_assets/

# Server runtime — Passenger restart trigger, deploy bookkeeping & logs
tmp/*
!tmp/.gitkeep
storage/deploy.log
.last_deployed
.last_deploy_check.tmp

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/
