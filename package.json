{
  "name": "rre-international",
  "version": "1.0.0",
  "description": "RRE International — Genuine Earthmoving & Heavy Equipment Replacement Spare Parts Exporter",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node src/server.js",
    "build:catalog": "node scripts/build-catalog.js && node scripts/build-category-mapping.js",
    "build:category-mapping": "node scripts/build-category-mapping.js",
    "extract:pdf-images": "bash scripts/run_pdf_extraction.sh",
    "match:images": "node scripts/match-images.js",
    "validate:catalog": "node scripts/validate-catalog.js"
  },
  "keywords": [
    "earthmoving-parts",
    "jcb-parts",
    "heavy-machinery",
    "spare-parts-exporter"
  ],
  "author": "RRE International",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-ejs-layouts": "^2.5.1",
    "lucide-static": "^1.33.0",
    "multer": "^2.2.0",
    "sharp": "^0.35.3",
    "xlsx": "^0.18.5"
  }
}
